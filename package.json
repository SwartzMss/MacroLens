{
  "name": "macrolens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:output": "node scripts/verify/metadata-visibility-output.mjs && node scripts/verify/concept-detail-output.mjs",
    "ingest:pmi": "node --import tsx scripts/ingest/cli.ts",
    "ingest:pboc-money-supply": "node --import tsx scripts/ingest/money-supply-cli.ts",
    "ingest:pboc-financial": "node --import tsx scripts/ingest/pboc-financial-cli.ts",
    "ingest:nbs-real-economy": "node --import tsx scripts/ingest/real-economy-cli.ts",
    "ingest:nbs-prices": "node --import tsx scripts/ingest/price-cli.ts",
    "ingest:customs-trade": "node --import tsx scripts/ingest/customs-trade-cli.ts",
    "ingest:lpr": "node --import tsx scripts/ingest/lpr-cli.ts",
    "ingest:policy-rate": "node --import tsx scripts/ingest/policy-rate-cli.ts",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^7.3.1",
    "echarts": "^6.0.0",
    "pagefind": "^1.3.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "tsx": "^4.23.13"
  }
}
