  {"data":{"source":"credit","target":"m2","type":"AFFECTS","relation":"transmission","lag":"数月","explanation":"信贷创造可能扩大存款余额，而存款余额属于广义货币 M2 的统计范围。"}},
  {"data":{"source":"credit","target":"social-financing","type":"OVERLAPS_WITH","relation":"synchronous_indicator","lag":"同月","explanation":"人民币贷款是社会融资的重要组成部分，因此两项指标经常描述相互重叠的融资活动。"}},
  {"data":{"source":"social-financing","target":"financing-conditions","type":"REFLECTS","relation":"lagging_indicator","lag":"数月","explanation":"社会融资记录已经实现的融资活动，因此可以帮助确认融资条件如何传导至实体经济。"}},
  {"data":{"source":"social-financing","target":"real-economy-financing","type":"MEASURES","relation":"synchronous_indicator","lag":"同月","explanation":"社会融资在其公布的统计范围内衡量实体经济获得的融资存量与增量。"}},
