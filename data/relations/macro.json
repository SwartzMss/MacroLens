  {"data":{"source":"producer-price-pressure","target":"downstream-price-pressure","type":"AFFECTS","relation":"transmission","lag":"数月","explanation":"企业调整投入成本和下游价格时，生产端价格压力可能沿供应链传导。"}},
  {"data":{"source":"downstream-price-pressure","target":"consumer-price-pressure","type":"AFFECTS","relation":"transmission","lag":"数月至数个季度","explanation":"企业调整价格、利润率和产品结构后，下游价格变化可能进一步传导至消费价格。"}},
  {"data":{"source":"price-transmission","target":"upstream-downstream-price-pass-through","type":"REFLECTS"}},
  {"data":{"source":"ppi","target":"cpi","type":"CORRELATES","relation":"leading_indicator","lag":"数月至数个季度","explanation":"PPI 与 CPI 分别观察不同定价环节，因此生产端价格变化可能为后续消费价格变化提供领先但不完整的信号。"}},
  {"data":{"source":"core-cpi","target":"cpi","type":"DERIVED_FROM"}},
  {"data":{"source":"pmi","target":"business-activity-conditions","type":"REFLECTS","relation":"leading_indicator","lag":"1—2 个月","explanation":"PMI 发布较早，可以在更广泛的季度产出数据之前提示企业活动的变化。"}},
  {"data":{"source":"business-activity-conditions","target":"economic-activity","type":"CORRELATES","relation":"synchronous_indicator","lag":"同一周期","explanation":"企业活动状况通常与总体经济活动同步变化，但这种关系会因行业和周期而异。"}},
  {"data":{"source":"gdp","target":"economic-activity","type":"MEASURES","relation":"synchronous_indicator","lag":"同一季度","explanation":"GDP 衡量一个时期内最终生产的价值，是官方对经济活动最广泛的汇总指标。"}},
  {"data":{"source":"industrial-production","target":"industrial-activity","type":"REFLECTS","relation":"synchronous_indicator","lag":"同月","explanation":"工业生产报告纳入统计范围的工业企业当前产出，反映经济活动中的工业部分。"}},
  {"data":{"source":"industrial-activity","target":"economic-activity","type":"COMPONENT_OF","relation":"synchronous_indicator","lag":"同一季度","explanation":"工业活动是更广泛经济活动的组成部分，不应被视为 GDP 总量的替代指标。"}},
  {"data":{"source":"retail-sales","target":"consumption-activity","type":"REFLECTS","relation":"synchronous_indicator","lag":"同月","explanation":"零售销售及时反映部分消费品交易，但只能部分代表居民消费总量。"}},
  {"data":{"source":"consumption-activity","target":"economic-activity","type":"COMPONENT_OF","relation":"synchronous_indicator","lag":"同一季度","explanation":"消费活动与投资、政府活动和净出口共同构成需求侧经济活动的重要部分。"}},
  {"data":{"source":"fixed-asset-investment","target":"investment-activity","type":"REFLECTS","relation":"synchronous_indicator","lag":"同月度至季度","explanation":"固定资产投资在其公布的统计范围和时点内，反映投资活动的重要部分。"}},
  {"data":{"source":"investment-activity","target":"economic-activity","type":"COMPONENT_OF","relation":"transmission","lag":"同季度至后续季度","explanation":"投资既增加当前需求，也可能影响未来生产能力，具体时点取决于项目完工和产能利用情况。"}},
  {"data":{"source":"economic-activity","target":"macro","type":"AFFECTS","relation":"synchronous_indicator","lag":"同一周期","explanation":"总体经济活动是理解更广泛增长与通胀环境的一个维度。"}},
  {"data":{"source":"economic-activity","target":"labor-market-conditions","type":"AFFECTS","relation":"transmission","lag":"1—2 个季度","explanation":"总体经济活动变化可能改变劳动需求，就业和失业指标往往会滞后调整。"}},
  {"data":{"source":"real-economy-financing","target":"activity","type":"AFFECTS","relation":"leading_factor","lag":"数月至数个季度","explanation":"流向实体经济的融资可以支持后续消费和投资活动，但实际效果还取决于需求和资产负债表状况。"}},
  {"data":{"source":"real-economy-financing","target":"investment-activity","type":"AFFECTS","relation":"leading_factor","lag":"数月至数个季度","explanation":"融资可用性可能先于投资活动变化，但项目需求、审批和实施过程决定其是否最终实现。"}},
  {"data":{"source":"activity","target":"macro","type":"AFFECTS","relation":"synchronous_indicator","lag":"同一周期","explanation":"消费和投资活动为判断当前宏观经济周期提供互补证据。"}},
