---
import '../styles/global.css';
import '../styles/data.css';
import '../styles/related.css';
const { title = 'MacroLens｜用一个镜头理解宏观经济', description = '以概念、关系和数据，理解宏观经济如何运转。' } = Astro.props;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}><meta name="generator" content={Astro.generator}>{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}<meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:site_name" content="MacroLens"><meta property="og:type" content="website">{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}<title>{title}</title></head><body>
<header class="site-header"><nav class="shell nav"><a class="brand" href="/"><i>Macro</i>Lens</a><a href="/concepts">概念</a><a href="/topics">主题</a><a href="/search">搜索</a></nav></header><main><slot /></main>
<footer class="site-footer"><div class="shell">MacroLens · 关系用于导航，文档用于解释，数据用于校验。</div></footer>
</body></html>
