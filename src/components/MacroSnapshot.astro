---
import type {
  MacroDomainState,
  MacroSnapshot,
  SnapshotConclusion,
  SnapshotEvidence,
} from '../data/macroSnapshot';
import '../styles/snapshot.css';
import { homeStateLabels, localizeExplanation } from '../data/home';

const { snapshot } = Astro.props as { snapshot: MacroSnapshot };

const formatValue = (value: number, unit: string) => `${value.toFixed(1)}${unit === '%' ? '%' : ` ${unit}`}`;
const formatChange = (change: number | null, changeUnit: string) => {
  if (change === null) return '—';
  const suffix = changeUnit === 'percentage-points' ? ' 个百分点' : changeUnit === 'points' ? ' 点' : '';
  return `${change > 0 ? '+' : ''}${change.toFixed(1)}${suffix}`;
};
const evidenceForConclusion = (domain: MacroDomainState, conclusion: SnapshotConclusion): SnapshotEvidence[] => {
  const evidenceById = new Map(domain.evidence.map((evidence) => [evidence.id, evidence]));
  return conclusion.evidenceIds
    .map((id) => evidenceById.get(id))
    .filter((evidence): evidence is SnapshotEvidence => Boolean(evidence));
};
---

<section class="snapshot section" aria-labelledby="snapshot-title">
  <div class="snapshot-head">
    <div>
      <div class="eyebrow">Macro snapshot</div>
      <h2 id="snapshot-title">这一期，宏观信号如何组合？</h2>
      <p>把已发布的指标事实、领域状态与明确规则分开呈现，帮助你理解快照是如何生成的。</p>
    </div>
    <div class="snapshot-meta">
      <span>数据集更新时间范围：{snapshot.freshness.earliestUpdatedAt} 至 {snapshot.freshness.latestUpdatedAt}</span>
      <span>{snapshot.freshness.note}</span>
    </div>
  </div>

  <div class="snapshot-disclaimer">这是基于已存数据的规则化观察，不构成投资建议或投资决策。</div>

  <section class="snapshot-synthesis" aria-labelledby="snapshot-synthesis-title">
    <div>
      <div class="eyebrow">Cross-domain synthesis</div>
      <h3 id="snapshot-synthesis-title">{snapshot.synthesis.label}</h3>
    </div>
    <p>{localizeExplanation(snapshot.synthesis.explanation)}</p>
  </section>

  <section class="snapshot-domains" aria-labelledby="snapshot-domains-title">
    <div class="section-head">
      <div>
        <div class="eyebrow">Domain evidence</div>
        <h3 id="snapshot-domains-title">领域状态与证据</h3>
      </div>
      <p>不同频率、观测期和数据来源分别保留</p>
    </div>

    <div class="snapshot-domain-grid">
      {snapshot.domains.map((domain) => <article class="snapshot-domain" data-domain={domain.id}>
        <header class="snapshot-domain-head">
          <div>
            <div class="eyebrow">{domain.id}</div>
            <h4>{domain.label}</h4>
          </div>
          <span class="snapshot-domain-state">{homeStateLabels[domain.state]}</span>
        </header>
        <p class="snapshot-domain-explanation">{localizeExplanation(domain.explanation)}</p>

        <div class="snapshot-domain-evidence">
          {domain.evidence.map((evidence) => <article class="snapshot-evidence">
            <div class="snapshot-evidence-head">
              <a href={evidence.conceptHref}>{evidence.name}</a>
              <span>{evidence.valueLabel}</span>
            </div>
            <div class="snapshot-evidence-value">{formatValue(evidence.latest, evidence.unit)}</div>
            <div class="snapshot-evidence-change">{evidence.changeLabel} {formatChange(evidence.change, evidence.changeUnit)}</div>
            <dl class="snapshot-evidence-meta">
              <div><dt>观测期</dt><dd>{evidence.observationPeriod}</dd></div>
              <div><dt>频率</dt><dd>{evidence.isEvent ? '事件观察' : evidence.frequency}</dd></div>
              <div><dt>更新</dt><dd>{evidence.updatedAt}</dd></div>
              {evidence.verifiedThrough ? <div><dt>核验至</dt><dd>{evidence.verifiedThrough}</dd></div> : null}
            </dl>
          </article>)}
        </div>

        <div class="snapshot-domain-conclusions">
          <section aria-labelledby={`snapshot-${domain.id}-risks`}>
            <div class="eyebrow">Risks to notice</div>
            <h5 id={`snapshot-${domain.id}-risks`}>需要留意</h5>
            {domain.risks.length > 0 ? <ul>{domain.risks.map((conclusion) => <li>
              <strong>{localizeExplanation(conclusion.title)}</strong>
              <p>{localizeExplanation(conclusion.explanation)}</p>
              <div class="snapshot-evidence-links">{evidenceForConclusion(domain, conclusion).map((evidence) => <a href={evidence.conceptHref}>{evidence.name}</a>)}</div>
            </li>)}</ul> : <p class="snapshot-empty">当前没有触发独立风险规则。</p>}
          </section>
          <section aria-labelledby={`snapshot-${domain.id}-watch`}>
            <div class="eyebrow">Watch next</div>
            <h5 id={`snapshot-${domain.id}-watch`}>下一期观察</h5>
            {domain.watchNext.length > 0 ? <ul>{domain.watchNext.map((conclusion) => <li>
              <strong>{localizeExplanation(conclusion.title)}</strong>
              <p>{localizeExplanation(conclusion.explanation)}</p>
              <div class="snapshot-evidence-links">{evidenceForConclusion(domain, conclusion).map((evidence) => <a href={evidence.conceptHref}>{evidence.name}</a>)}</div>
            </li>)}</ul> : <p class="snapshot-empty">暂无额外观察项。</p>}
          </section>
        </div>
      </article>)}
    </div>
  </section>
</section>
