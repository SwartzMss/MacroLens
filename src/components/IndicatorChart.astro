---
import type { IndicatorDataset } from '../data/indicatorRegistry';
const { indicator } = Astro.props as { indicator: IndicatorDataset };
const id = `chart-${indicator.id}`;
const series = indicator.series ?? [{ id: 'default', label: indicator.label, data: indicator.data }];
---
<div class="viz-card"><div class="viz-head"><h3>{indicator.chartTitle}</h3><span class="tag">{indicator.label} · {indicator.unit}</span></div><div class="chart" id={id} data-chart={JSON.stringify({series,unit:indicator.unit,chartType:indicator.chartType,verifiedThrough:indicator.verifiedThrough,referenceValue:indicator.referenceValue,referenceLabel:indicator.referenceLabel})} role="img" aria-label={`${indicator.chartTitle}${indicator.chartType === 'step' ? '阶梯图' : '折线图'}`}></div></div>
<script>
  import * as echarts from 'echarts';
  import { buildIndicatorChartOption, type IndicatorChartConfig } from '../data/indicatorChartOption';
  document.querySelectorAll<HTMLElement>('[data-chart]').forEach((element) => {
    if (element.dataset.ready) return;
    element.dataset.ready = 'true';
    const config: IndicatorChartConfig = JSON.parse(element.dataset.chart || '{}');
    const chart = echarts.init(element);
    chart.setOption(buildIndicatorChartOption(config));
    new ResizeObserver(()=>chart.resize()).observe(element);
  });
</script>
