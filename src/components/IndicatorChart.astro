---
import type { IndicatorDataset } from '../data/indicatorRegistry';
const { indicator } = Astro.props as { indicator: IndicatorDataset };
const id = `chart-${Math.random().toString(36).slice(2)}`;
---
<div class="viz-card"><div class="viz-head"><h3>{indicator.chartTitle}</h3><span class="tag">{indicator.label} · {indicator.unit}</span></div><div class="chart" id={id} data-chart={JSON.stringify({data:indicator.data,unit:indicator.unit,referenceValue:indicator.referenceValue,referenceLabel:indicator.referenceLabel})} role="img" aria-label={`${indicator.chartTitle}折线图`}></div></div>
<script>
  import * as echarts from 'echarts';
  document.querySelectorAll<HTMLElement>('[data-chart]').forEach((element) => {
    if (element.dataset.ready) return;
    element.dataset.ready = 'true';
    const config: {data:{date:string,value:number}[],unit:string,referenceValue?:number,referenceLabel?:string} = JSON.parse(element.dataset.chart || '{}');
    const data = config.data || [];
    const chart = echarts.init(element);
    chart.setOption({animationDuration:700,tooltip:{trigger:'axis'},grid:{left:44,right:20,top:28,bottom:38},xAxis:{type:'category',data:data.map(d=>d.date),axisLine:{lineStyle:{color:'#b9c2ba'}}},yAxis:{type:'value',name:config.unit,splitLine:{lineStyle:{color:'#e7e8e1'}}},series:[{type:'line',data:data.map(d=>d.value),smooth:.25,symbolSize:7,lineStyle:{width:3,color:'#0d6b50'},itemStyle:{color:'#0d6b50'},areaStyle:{color:'rgba(13,107,80,.09)'},markLine:config.referenceValue===undefined?undefined:{silent:true,symbol:'none',label:{formatter:config.referenceLabel||String(config.referenceValue)},data:[{yAxis:config.referenceValue}]}}]});
    new ResizeObserver(()=>chart.resize()).observe(element);
  });
</script>
