---
import type { CollectionEntry } from 'astro:content';
import type { LearningPath } from '../../data/home';

const { paths, concepts } = Astro.props as {
  paths: LearningPath[];
  concepts: CollectionEntry<'concepts'>[];
};
const conceptIds = new Set(concepts.map((concept) => concept.data.id));
const conceptHref = (id: string) => {
  if (!conceptIds.has(id)) throw new Error(`Homepage learning path references missing concept: ${id}`);
  return `/concepts/${id}`;
};
---

<section class="home-section home-learning" id="learning-paths" aria-labelledby="learning-paths-title">
  <div class="home-section-heading">
    <div>
      <div class="eyebrow">04 / 从这里开始</div>
      <h2 id="learning-paths-title">从一条路径开始</h2>
    </div>
    <p>先建立方向感，再进入完整概念库。</p>
  </div>

  <div class="learning-path-grid">
    {paths.map((path) => <article class="learning-path-card">
      <div class="learning-path-number">{path.number}</div>
      <h3>{path.title}</h3>
      <p>{path.description}</p>
      <ol>
        {path.steps.map((step, index) => <li><a href={conceptHref(step.id)}><span class="learning-step-index">{index + 1}</span>{step.label}</a></li>)}
      </ol>
      <a class="home-inline-link learning-start" href={conceptHref(path.steps[0].id)}>开始第一步：{path.steps[0].label} →</a>
    </article>)}
  </div>
</section>
