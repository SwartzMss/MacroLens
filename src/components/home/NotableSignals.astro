---
import type { HomepageNotableSignal } from '../../data/home';
import { formatSignalChange } from '../../data/home';

const { signals } = Astro.props as { signals: HomepageNotableSignal[] };
---

<section class="home-section home-signals" id="notable-signals" aria-labelledby="notable-signals-title">
  <div class="home-section-heading">
    <div>
      <div class="eyebrow">02 / 关键读数</div>
      <h2 id="notable-signals-title">把变化放回数据里</h2>
    </div>
    <p>先看变化，再回到指标的定义和图表。</p>
  </div>

  <div class="home-signal-grid">
    {signals.map((signal) => <article class="home-signal-card">
      <div class="home-signal-topline">
        <a href={signal.conceptHref}>{signal.name}</a>
        <span>{signal.observationPeriod}</span>
      </div>
      <div class="home-signal-metric">{signal.valueLabel === '率水平' ? '失业率水平' : signal.valueLabel}</div>
      <div class="home-signal-value">{signal.latest.toFixed(1)}<small>{signal.unit === 'index' ? '点' : signal.unit}</small></div>
      <div class="home-signal-change">
        <span>{signal.changeLabel}</span>
        <strong>{formatSignalChange(signal)}</strong>
      </div>
      <a class="home-signal-detail" href={signal.conceptHref}>查看定义与图表 →</a>
    </article>)}
  </div>
</section>
