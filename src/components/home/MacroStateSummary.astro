---
import type { MacroSnapshot } from '../../data/macroSnapshot';
import { homeStateLabels, localizeExplanation, getHomeSynthesis } from '../../data/home';

const { snapshot } = Astro.props as { snapshot: MacroSnapshot };
---

<section class="home-section home-state" id="macro-state" aria-labelledby="macro-state-title">
  <div class="home-section-heading">
    <div>
      <div class="eyebrow">01 / 当前宏观状态</div>
      <h2 id="macro-state-title">现在，经济有哪些信号？</h2>
    </div>
    <a class="home-inline-link" href="/snapshot">查看完整宏观快照 →</a>
  </div>

  <div class="home-synthesis">
    <div>
      <div class="eyebrow">综合观察</div>
      <h3>{snapshot.synthesis.label}</h3>
    </div>
    <p>{getHomeSynthesis(snapshot)}</p>
  </div>
  <p class="home-freshness">数据集最近更新：<time>{snapshot.freshness.latestUpdatedAt}</time> · 各指标观察期不同，具体期间见读数与详情。</p>

  <div class="home-domain-grid">
    {snapshot.domains.map((domain) => <article class="home-domain" data-state={domain.state}>
      <div class="home-domain-topline">
        <span class="home-domain-label">{domain.label}</span>
        <span class="home-state-chip">{homeStateLabels[domain.state]}</span>
      </div>
      <p>{domain.id === 'policy-financial-conditions'
        ? `综合政策利率与 LPR 观察，当前状态为${homeStateLabels[domain.state]}。`
        : `${localizeExplanation(domain.explanation).split(/[；;。]/)[0]}。`}</p>
      <details class="home-domain-details">
        <summary>依据与解读边界</summary>
        <p>{localizeExplanation(domain.explanation)}</p>
        <ul>{domain.evidence.map(item => <li><a href={item.conceptHref}>{item.name}</a><span>{item.observationPeriod}</span></li>)}</ul>
      </details>
    </article>)}
  </div>
</section>
