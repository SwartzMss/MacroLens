---
import type { MacroDomainId, MacroSnapshot } from '../../data/macroSnapshot';
import { homeStateLabels, localizeExplanation } from '../../data/home';
import { getMacroNowQuestionForDomain } from '../../data/macroNow';
import LatestReading from './LatestReading.astro';

const { snapshot } = Astro.props as { snapshot: MacroSnapshot };
const featuredDomainIds: MacroDomainId[] = ['growth', 'credit-liquidity', 'prices'];
const domains = featuredDomainIds.map(id => snapshot.domains.find(domain => domain.id === id)).filter((domain): domain is NonNullable<typeof domain> => Boolean(domain));
---

<section class="home-section home-state" id="macro-state" aria-labelledby="macro-state-title">
  <div class="home-section-heading">
    <div>
      <h2 id="macro-state-title">现在，经济有哪些信号？</h2>
    </div>
    <a class="home-inline-link" href="/now/">查看当前宏观 →</a>
  </div>

  <div class="home-domain-grid">
    {domains.map((domain) => { const question = getMacroNowQuestionForDomain(domain.id); return <article class="home-domain" data-domain={domain.id} data-state={domain.state}>
      <div class="home-domain-intro">
        <div class="home-domain-topline">
          <h3 class="home-domain-label">{question.label}</h3>
          <span class="home-state-chip">{homeStateLabels[domain.state]}</span>
        </div>
        <p class="home-domain-question"><a href={question.href}>{question.question}</a></p>
        <p>{`${localizeExplanation(domain.explanation).split(/[；;。]/)[0]}。`}</p>
        <a class="home-domain-detail-link" href={question.href}>查看这组数据 →</a>
      </div>
      <ul class="home-domain-readings" aria-label={`${domain.label}最新数据`}>
        {domain.evidence.map(item => <li><LatestReading signal={item} /></li>)}
      </ul>
    </article>; })}
  </div>
  <p class="home-freshness">数据更新时间：<time>{snapshot.freshness.latestUpdatedAt}</time> · 详细期间和口径见当前宏观。</p>
</section>
