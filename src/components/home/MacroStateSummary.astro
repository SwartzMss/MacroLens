---
import type { MacroDomainStateValue, MacroSnapshot } from '../../data/macroSnapshot';

const { snapshot } = Astro.props as { snapshot: MacroSnapshot };
const stateLabels: Record<MacroDomainStateValue, string> = {
  strengthening: '走强',
  weakening: '走弱',
  stable: '稳定',
  mixed: '混合',
  divergent: '分化',
  easing: '宽松',
  tightening: '收紧',
  elevated: '偏高',
  notable: '值得关注',
};
---

<section class="home-section home-state" id="macro-state" aria-labelledby="macro-state-title">
  <div class="home-section-heading">
    <div>
      <div class="eyebrow">Current macro state</div>
      <h2 id="macro-state-title">现在，宏观系统处在什么状态？</h2>
    </div>
    <a class="home-inline-link" href="/snapshot">查看完整 Macro Snapshot →</a>
  </div>

  <div class="home-synthesis">
    <div>
      <div class="eyebrow">Cross-domain synthesis</div>
      <h3>{snapshot.synthesis.label}</h3>
    </div>
    <p>{snapshot.synthesis.explanation}</p>
  </div>

  <div class="home-domain-grid">
    {snapshot.domains.map((domain) => <article class="home-domain" data-state={domain.state}>
      <div class="home-domain-topline">
        <span class="home-domain-label">{domain.label}</span>
        <span class="home-state-chip">{stateLabels[domain.state]}</span>
      </div>
      <p>{domain.explanation}</p>
    </article>)}
  </div>
</section>
