---
import {
  getRelationData,
  isExplainableRelation,
  isSymmetricRelation,
  macroNodeTypeLabels,
} from '../../data/graphRegistry';

type ConceptLink = { data: { id: string; name: string } };
type Props = {
  graphId: string;
  concepts: ConceptLink[];
  focusNodeId?: string;
  focusConceptIds?: readonly string[];
  title?: string;
  eyebrow?: string;
  description?: string;
  limit?: number;
};

const {
  graphId,
  concepts,
  focusNodeId,
  focusConceptIds = [],
  title = '沿着关系继续探索',
  eyebrow = '关系探索',
  description = '这些线索来自宏观关系图。打开关系浏览器，可查看关系类型；已补充解释的关系还会显示时间、适用条件与证据。',
  limit = 4,
} = Astro.props as Props;
const { nodes, relations } = getRelationData(graphId);
const nodesById = new Map(nodes.map((node) => [node.id, node]));
const conceptsById = new Map(concepts.map((concept) => [concept.data.id, concept]));
const routeConceptIds = new Set(focusConceptIds);
const routeRelations = relations
  .filter((relation) => {
    if (routeConceptIds.size === 0) return false;
    return routeConceptIds.has(relation.source) && routeConceptIds.has(relation.target);
  });
const candidateRelations = (focusNodeId
  ? relations.filter((relation) => relation.source === focusNodeId || relation.target === focusNodeId)
  : routeRelations.length > 0
    ? routeRelations
    : relations.filter((relation) => routeConceptIds.has(relation.source) || routeConceptIds.has(relation.target)))
  .slice(0, limit);
const nodeLabel = (id: string) => conceptsById.get(id)?.data.name ?? nodesById.get(id)?.label ?? id;
const nodeType = (id: string) => nodesById.get(id)?.type;
const nodeHref = (id: string) => `/graph?node=${encodeURIComponent(id)}`;
const relationLabels = {
  leading_indicator: '领先指标',
  leading_factor: '领先因素',
  synchronous_indicator: '同步指标',
  lagging_indicator: '滞后指标',
  transmission: '传导环节',
} as const;
const canonicalRelationLabels = {
  CAUSES: '导致',
  AFFECTS: '影响',
  REFLECTS: '反映',
  CORRELATES: '通常相关',
  COMPONENT_OF: '构成',
  IMPLEMENTS: '实施',
  USES: '使用',
  OVERLAPS_WITH: '范围重叠',
  MEASURES: '衡量',
  DERIVED_FROM: '派生自',
} as const;
const relationLabel = (relation: (typeof relations)[number]) => isExplainableRelation(relation)
  ? relationLabels[relation.relation]
  : canonicalRelationLabels[relation.type];
const relationArrow = (relation: (typeof relations)[number]) => isSymmetricRelation(relation.type) ? '↔' : '→';
const bridgeNodeId = focusNodeId ?? candidateRelations[0]?.source;
---

{candidateRelations.length > 0 && <section class="learning-graph-bridge" data-learning-graph-bridge data-graph-node={bridgeNodeId} aria-labelledby={`${bridgeNodeId}-learning-graph-title`}>
  <div class="eyebrow">{eyebrow}</div>
  <h2 id={`${bridgeNodeId}-learning-graph-title`}>{title}</h2>
  <p>{description}</p>
  <ul class="learning-graph-bridge-list">
    {candidateRelations.map((relation) => <li>
      <a href={nodeHref(relation.source)}>{nodeLabel(relation.source)}<small>{nodeType(relation.source) ? macroNodeTypeLabels[nodeType(relation.source)!] : ''}</small></a>
      <span class="learning-graph-bridge-relation"><small>{relationLabel(relation)}</small>{relationArrow(relation)}</span>
      <a href={nodeHref(relation.target)}>{nodeLabel(relation.target)}<small>{nodeType(relation.target) ? macroNodeTypeLabels[nodeType(relation.target)!] : ''}</small></a>
    </li>)}
  </ul>
  <a class="learning-button" href={nodeHref(bridgeNodeId)}>打开关系浏览器 →</a>
</section>}
