<script>
  import { courseStorageKey, parseCourseProgress, toggleCourseCompletion, saveCourseProgress, courseResumeTarget } from '../../data/courseProgress';
  import { courseLessonHref } from '../../data/courseOutline';
  let progress = parseCourseProgress(null);
  try { progress = parseCourseProgress(localStorage.getItem(courseStorageKey)); } catch {}
  const lesson = document.querySelector<HTMLElement>('[data-course-lesson]')?.dataset.courseLesson;
  const nextLink = document.querySelector<HTMLAnchorElement>('[data-course-next]');
  function render() {
    const resume = document.querySelector<HTMLAnchorElement>('[data-course-resume]');
    if (resume) {
      const target = courseResumeTarget(progress);
      resume.href = courseLessonHref(target.id);
      resume.textContent = target.label;
    }
  }
  function save() {
    try { saveCourseProgress(localStorage, progress); } catch {}
    render();
  }
  if (lesson) { progress.lastVisited = lesson; save(); }
  nextLink?.addEventListener('click', () => {
    if (!lesson || progress.completed.includes(lesson)) return;
    progress = toggleCourseCompletion(progress, lesson);
    save();
  });
  render();
  function refresh() {
    try { progress = parseCourseProgress(localStorage.getItem(courseStorageKey)); } catch {}
    render();
  }
  window.addEventListener('pageshow', event => { if (event.persisted) refresh(); });
  window.addEventListener('storage', event => { if (event.key === courseStorageKey || event.key === null) refresh(); });
</script>
