---
import type { DashboardIndicator } from '../data/dashboard';
import '../styles/dashboard.css';
import { getIndicatorPresentation } from '../data/indicatorPresentationAdapter';

const { indicators } = Astro.props as { indicators: DashboardIndicator[] };
const formatValue = (value: number, unit: string) => `${value.toFixed(1)}${unit === '%' ? '%' : ''}`;
const changeSuffix = (metric: string) => metric === 'yoy' || metric === 'mom' || metric === 'cumulative_yoy'
  ? ' 个百分点'
  : metric === 'index' ? ' 点' : '';
const formatChange = (change: number | null, metric: string) => {
  if (change === null) return '—';
  return `${change > 0 ? '+' : ''}${change.toFixed(1)}${changeSuffix(metric)}`;
};
---

<section class="dashboard section" aria-labelledby="dashboard-title">
  <div class="dashboard-head">
    <div>
      <div class="eyebrow">Macro dashboard</div>
      <h2 id="dashboard-title">现在，宏观数据说什么？</h2>
      <p>从现有官方数据集中读取最新观测，快速浏览经济活动、货币与需求的变化。</p>
    </div>
  </div>

  <div class="dashboard-grid">
    {indicators.map((item) => {
      const presentation = getIndicatorPresentation(item.dataset);
      return <article class="indicator-card" data-indicator-id={item.id}>
        <div class="indicator-card-top">
          <span>{presentation.valueLabel}</span>
        </div>
        <h3>{item.name}</h3>
        <div class="indicator-value">{formatValue(item.latest.value, item.dataset.unit)}</div>
        <div class:list={['indicator-change', item.change !== null && item.change < 0 && 'is-negative']}>
          <span>{presentation.changeLabel}</span>
          <strong>{formatChange(item.change, item.dataset.metric)}</strong>
        </div>
        <div class="indicator-meta">
          <span>数据期：{item.latest.date}</span>
        </div>
        <div class="indicator-actions">
          <a href={item.conceptHref}>查看定义与图表 →</a>
        </div>
      </article>;
    })}
  </div>

  <section class="dashboard-changes" aria-labelledby="dashboard-changes-title">
    <div class="section-head">
      <div>
        <div class="eyebrow">Recent changes</div>
        <h3 id="dashboard-changes-title">最近一期变化</h3>
      </div>
    </div>
    <ul>{indicators.map((item) => <li>
      <a href={item.conceptHref}>{item.name}</a>
      <span>{item.latest.date} · {getIndicatorPresentation(item.dataset).changeLabel}</span>
      <strong class={item.change !== null && item.change < 0 ? 'is-negative' : ''}>{formatChange(item.change, item.dataset.metric)}</strong>
    </li>)}</ul>
  </section>
</section>
