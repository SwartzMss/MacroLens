---
import { getConceptRelations, type ConceptRelation, type Relation, type RelationNode, type RelationType } from '../data/graphRegistry';

type GraphProps = {
  nodes: RelationNode[];
  relations: Relation[];
  conceptIds: string[];
  initialNodeId: string;
};

const { nodes, relations, conceptIds, initialNodeId } = Astro.props as GraphProps;
const nodesById = new Map(nodes.map((node) => [node.id, node]));
const selectedNode = nodesById.get(initialNodeId) ?? nodes[0];
if (!selectedNode) throw new Error('The relationship graph must contain an initial node');

const relationLabels: Record<RelationType, string> = {
  CAUSES: '导致', AFFECTS: '影响', REFLECTS: '反映', CORRELATES: '通常相关',
  COMPONENT_OF: '构成', IMPLEMENTS: '实施', USES: '使用', OVERLAPS_WITH: '范围重叠',
  MEASURES: '衡量', DERIVED_FROM: '派生自',
};

const relationGroups = [
  { key: 'incoming', heading: '上游 / 指向它' },
  { key: 'outgoing', heading: '下游 / 它指向' },
  { key: 'symmetric', heading: '相互关联' },
] as const;

const initialRelations = getConceptRelations('macro', selectedNode.id);
const groupedRelations = relationGroups.map((group) => ({
  ...group,
  items: initialRelations.filter((item) => item.direction === group.key),
})).filter((group) => group.items.length > 0);

function otherLink(item: ConceptRelation) {
  const node = item.other;
  return conceptIds.includes(node.id) ? (
    <a href={`/concepts/${node.id}`}>{node.label}</a>
  ) : (
    <span class="graph-abstract-node">{node.label}<small>图谱概念</small></span>
  );
}

function relationArrow(item: ConceptRelation) {
  if (item.direction === 'symmetric') return '↔';
  return item.relation.source === selectedNode.id ? '→' : '←';
}

function relationText(item: ConceptRelation) {
  const label = relationLabels[item.relation.type];
  const arrow = relationArrow(item);
  return item.direction === 'incoming' ? `${item.other.label} ${arrow} ${selectedNode.label} · ${label}` : `${selectedNode.label} ${arrow} ${item.other.label} · ${label}`;
}
---

<section class="graph-shell" data-graph data-payload={JSON.stringify({ nodes, relations, conceptIds, initialNodeId: selectedNode.id })}>
  <div class="graph-controls">
    <label for="graph-node">查找节点</label>
    <select id="graph-node" data-graph-select>
      {nodes.map((node) => <option value={node.id} selected={node.id === selectedNode.id}>{node.label}</option>)}
    </select>
    <p>选择节点后，图中会突出显示它的直接关系。</p>
  </div>
  <div class="graph-layout">
    <div class="graph-canvas" data-graph-canvas role="img" aria-label="宏观指标关系图"></div>
    <aside class="graph-details" data-graph-details aria-live="polite">
      <div class="eyebrow">Selected node</div>
      <h2>{selectedNode.label}</h2>
      {conceptIds.includes(selectedNode.id) ? <a class="graph-concept-link" href={`/concepts/${selectedNode.id}`}>打开概念页 →</a> : <p class="graph-note">图谱概念：用于解释关系，不单独提供概念页。</p>}
      {groupedRelations.map((group) => <section class="graph-detail-group">
        <h3>{group.heading}</h3>
        <ul>{group.items.map((item) => <li><span class="graph-relation-text">{relationText(item)}</span>{otherLink(item)}</li>)}</ul>
      </section>)}
    </aside>
  </div>
  <p class="graph-note graph-footnote">关系来自手工维护的 canonical dataset，用于解释和导航，不自动生成因果结论。</p>
  <noscript><p class="graph-note">启用 JavaScript 后可拖拽、缩放并聚焦节点；上方关系列表仍可直接阅读。</p></noscript>
</section>

<script>
  import * as echarts from 'echarts';

  type BrowserNode = { id: string; label: string; kind?: string };
  type BrowserRelation = { source: string; target: string; type: string };
  type GraphPayload = { nodes: BrowserNode[]; relations: BrowserRelation[]; conceptIds: string[]; initialNodeId: string };
  type RelationDirection = 'incoming' | 'outgoing' | 'symmetric';

  const labels: Record<string, string> = {
    CAUSES: '导致', AFFECTS: '影响', REFLECTS: '反映', CORRELATES: '通常相关',
    COMPONENT_OF: '构成', IMPLEMENTS: '实施', USES: '使用', OVERLAPS_WITH: '范围重叠',
    MEASURES: '衡量', DERIVED_FROM: '派生自',
  };
  const symmetricTypes = new Set(['CORRELATES', 'OVERLAPS_WITH']);

  const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (character) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;',
  }[character] || character));

  document.querySelectorAll<HTMLElement>('[data-graph]').forEach((root) => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const canvas = root.querySelector<HTMLElement>('[data-graph-canvas]');
    const select = root.querySelector<HTMLSelectElement>('[data-graph-select]');
    const details = root.querySelector<HTMLElement>('[data-graph-details]');
    if (!canvas || !select || !details) return;
    const graphCanvas = canvas;
    const graphSelect = select;
    const graphDetails = details;

    const payload = JSON.parse(root.dataset.payload || '{}') as GraphPayload;
    const nodesById = new Map(payload.nodes.map((node) => [node.id, node]));
    const conceptIds = new Set(payload.conceptIds);
    const chart = echarts.init(graphCanvas);
    const relationDirection = (relation: BrowserRelation, nodeId: string): RelationDirection => {
      if (symmetricTypes.has(relation.type)) return 'symmetric';
      return relation.source === nodeId ? 'outgoing' : 'incoming';
    };
    const relationsFor = (nodeId: string) => payload.relations.filter((relation) => relation.source === nodeId || relation.target === nodeId);

    const graphNodes = payload.nodes.map((node) => ({
      id: node.id,
      name: node.label,
      category: node.kind === 'indicator' ? 0 : 1,
      symbolSize: node.kind === 'indicator' ? 19 : 13,
    }));
    const graphLinks = payload.relations.map((relation) => ({
      source: relation.source,
      target: relation.target,
      name: labels[relation.type] || relation.type,
      symbol: symmetricTypes.has(relation.type) ? ['none', 'none'] : ['none', 'arrow'],
      lineStyle: symmetricTypes.has(relation.type) ? { type: 'dashed' } : undefined,
    }));

    chart.setOption({
      animationDuration: 500,
      tooltip: { formatter: (params: { dataType?: string; data?: { name?: string } }) => params.dataType === 'node' ? params.data?.name : '' },
      legend: { data: ['指标', '解释性概念'], bottom: 4, textStyle: { color: '#64736d' } },
      series: [{
        type: 'graph', layout: 'force', roam: true, draggable: true,
        data: graphNodes, links: graphLinks,
        categories: [{ name: '指标' }, { name: '解释性概念' }],
        force: { repulsion: 240, gravity: 0.08, edgeLength: [70, 170] },
        label: { show: true, position: 'right', formatter: (params: { data?: { name?: string } }) => params.data?.name || '', color: '#15241f', fontSize: 12 },
        lineStyle: { color: '#a9b8ae', width: 1.2, curveness: 0.12 },
        edgeLabel: { show: false },
        emphasis: { focus: 'adjacency', lineStyle: { width: 2.4 } },
      }],
    });

    function renderDetails(nodeId: string) {
      const node = nodesById.get(nodeId);
      if (!node) return;
      const groups: Record<RelationDirection, BrowserRelation[]> = { incoming: [], outgoing: [], symmetric: [] };
      for (const relation of relationsFor(nodeId)) groups[relationDirection(relation, nodeId)].push(relation);
      const headings: Record<RelationDirection, string> = { incoming: '上游 / 指向它', outgoing: '下游 / 它指向', symmetric: '相互关联' };
      const linkedNode = (otherId: string) => {
        const other = nodesById.get(otherId);
        if (!other) return '';
        if (conceptIds.has(other.id)) return `<a href="/concepts/${encodeURIComponent(other.id)}">${escapeHtml(other.label)}</a>`;
        return `<span class="graph-abstract-node">${escapeHtml(other.label)}<small>图谱概念</small></span>`;
      };
      const groupMarkup = (direction: RelationDirection) => {
        if (groups[direction].length === 0) return '';
        const items = groups[direction].map((relation) => {
          const otherId = relation.source === nodeId ? relation.target : relation.source;
          const arrow = direction === 'symmetric' ? '↔' : direction === 'outgoing' ? '→' : '←';
          const relationLabel = escapeHtml(labels[relation.type] || relation.type);
          const current = `<strong>${escapeHtml(node.label)}</strong>`;
          const other = linkedNode(otherId);
          const path = direction === 'incoming' ? `${other} <span class="graph-arrow">${arrow}</span> ${current}` : `${current} <span class="graph-arrow">${arrow}</span> ${other}`;
          return `<li><span class="graph-relation-text">${path} · ${relationLabel}</span></li>`;
        }).join('');
        return `<section class="graph-detail-group"><h3>${headings[direction]}</h3><ul>${items}</ul></section>`;
      };
      const pageLink = conceptIds.has(node.id) ? `<a class="graph-concept-link" href="/concepts/${encodeURIComponent(node.id)}">打开概念页 →</a>` : '<p class="graph-note">图谱概念：用于解释关系，不单独提供概念页。</p>';
      graphDetails.innerHTML = `<div class="eyebrow">Selected node</div><h2>${escapeHtml(node.label)}</h2>${pageLink}${groupMarkup('incoming')}${groupMarkup('outgoing')}${groupMarkup('symmetric')}`;
    }

    function selectNode(nodeId: string) {
      if (!nodesById.has(nodeId)) return;
      graphSelect.value = nodeId;
      renderDetails(nodeId);
      chart.dispatchAction({ type: 'downplay', seriesIndex: 0 });
      chart.dispatchAction({ type: 'highlight', seriesIndex: 0, name: nodesById.get(nodeId)?.label });
    }

    chart.on('click', (params) => {
      const data = params.data as { id?: string } | null | undefined;
      if (params.dataType === 'node' && data?.id) selectNode(data.id);
    });
    graphSelect.addEventListener('change', () => selectNode(graphSelect.value));
    new ResizeObserver(() => chart.resize()).observe(graphCanvas);
    selectNode(payload.initialNodeId);
  });
</script>
