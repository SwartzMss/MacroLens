---
import type { ConceptKnowledge } from '../data/conceptKnowledge';
import { isExplainableRelation, type RelationType, type ExplainableRelationType } from '../data/graphRegistry';
import '../styles/concept-knowledge.css';

const { conceptId, knowledge, showSummary = true } = Astro.props as { conceptId: string; knowledge: ConceptKnowledge; showSummary?: boolean };
const relationLabels: Record<RelationType, string> = {
  CAUSES: '导致', AFFECTS: '影响', REFLECTS: '反映', CORRELATES: '通常相关', COMPONENT_OF: '构成',
  IMPLEMENTS: '实施', USES: '使用', OVERLAPS_WITH: '范围重叠', MEASURES: '衡量', DERIVED_FROM: '派生自',
};
const explainableLabels: Record<ExplainableRelationType, string> = {
  leading_indicator: '领先指标', leading_factor: '领先因素', synchronous_indicator: '同步指标',
  lagging_indicator: '滞后指标', transmission: '传导环节',
};
const relationLabel = (type: RelationType, relation: string | undefined) => (
  relation && relation in explainableLabels
    ? explainableLabels[relation as ExplainableRelationType]
    : relationLabels[type]
);
---

<section class="knowledge-overview" id={`${conceptId}-knowledge`} aria-labelledby={`${conceptId}-knowledge-title`}>
  <header class="knowledge-overview-head">
    <div>
      <div class="eyebrow">理解与联系</div>
      <h2 id={`${conceptId}-knowledge-title`}>把概念放进理解地图</h2>
    </div>
    {knowledge.relationCount > 0 && <span class="knowledge-count">{knowledge.relationCount} 个直接关系</span>}
  </header>

  <div class:list={['knowledge-summary-grid', !showSummary && 'without-summary']}>
    {showSummary ? <section class="knowledge-quick" aria-labelledby={`${conceptId}-quick-title`}>
      <div class="knowledge-label">Quick understanding</div>
      <h3 id={`${conceptId}-quick-title`}>一句话理解</h3>
      <p>{knowledge.summary}</p>
      <div class="knowledge-reading-order" aria-label="推荐理解顺序">
        <span>概念</span><b aria-hidden="true">→</b><span>关系链</span><b aria-hidden="true">→</b><span>指标</span><b aria-hidden="true">→</b><span>证据 / 边界</span>
      </div>
    </section> : <span id={`${conceptId}-quick-title`} class="detail-anchor" aria-hidden="true"></span>}

    {knowledge.indicators.length > 0 && <section class="knowledge-indicators" aria-labelledby={`${conceptId}-indicators-title`}>
      <div class="knowledge-label">继续看数据</div>
      <h3 id={`${conceptId}-indicators-title`}>相关指标</h3>
      <ul>
        {knowledge.indicators.map((indicator) => <li>
          <a href={`/concepts/${indicator.data.id}`}>
            <span><strong>{indicator.data.name}</strong><small>{indicator.data.subtitle}</small></span>
            <b aria-hidden="true">→</b>
          </a>
          <span class="knowledge-indicator-tag">数据图表</span>
        </li>)}
      </ul>
    </section>}
  </div>

  {knowledge.chain.length > 0 && <section class="knowledge-chain-block" aria-labelledby={`${conceptId}-chain-title`}>
    <div class="knowledge-block-head">
      <div>
        <div class="knowledge-label">沿关系理解</div>
        <h3 id={`${conceptId}-chain-title`}>关键关系链</h3>
      </div>
      <p>只展示图谱中已有的关系，不把关系解读为确定因果。</p>
    </div>
    <ol class="knowledge-chain">
      {knowledge.chain.map((step) => <li>
        <div class="knowledge-chain-node">{step.source.href ? <a href={step.source.href}>{step.source.label}</a> : <span>{step.source.label}</span>}</div>
        <div class="knowledge-chain-edge"><small>{relationLabel(step.relation.type, isExplainableRelation(step.relation) ? step.relation.relation : undefined)}</small><b aria-hidden="true">→</b></div>
        <div class="knowledge-chain-node is-target">{step.target.href ? <a href={step.target.href}>{step.target.label}</a> : <span>{step.target.label}</span>}</div>
      </li>)}
    </ol>
  </section>}

  {(knowledge.limitations.length > 0 || knowledge.evidence.length > 0) && <div class="knowledge-context-grid">
    {knowledge.limitations.length > 0 && <details class="knowledge-disclosure">
      <summary><span>局限与解读边界</span><small>{knowledge.limitations.length} 条</small></summary>
      <ul>{knowledge.limitations.map((limitation) => <li>{limitation}</li>)}</ul>
    </details>}
    {knowledge.evidence.length > 0 && <details class="knowledge-disclosure">
      <summary><span>证据与来源</span><small>{knowledge.evidence.length} 条</small></summary>
      <ul>{knowledge.evidence.map((item) => <li><a href={item.url} target="_blank" rel="noreferrer">{item.title} ↗</a></li>)}</ul>
    </details>}
  </div>}
</section>
