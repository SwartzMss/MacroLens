---
type Props = {
  className: string;
  caption: string;
  label: string;
  value?: string;
  href?: string;
};

const { className, caption, label, value, href } = Astro.props as Props;
const classes = [className, href && 'is-link'];
---

{href ? <a class:list={classes} href={href} aria-label={`查看${label}概念定义`}>
  <small>{caption}</small>
  <strong>{label}</strong>
  {value && <span>{value}</span>}
</a> : <div class:list={classes}>
  <small>{caption}</small>
  <strong>{label}</strong>
  {value && <span>{value}</span>}
</div>}
