---
import type { getGraphData } from '../data/graphRegistry';
type GraphData = ReturnType<typeof getGraphData>;
type GraphMode = 'overview' | 'local' | 'full';
const { graph, title = '概念关系图', mode = 'local', focusId, conceptIds = [], exploreHref } = Astro.props as {
  graph: GraphData; title?: string; mode?: GraphMode; focusId?: string; conceptIds?: string[]; exploreHref?: string;
};
const id = `graph-${Math.random().toString(36).slice(2)}`;
const nodes = graph.filter(item => item.data.id);
---
<div class:list={['viz-card', 'graph-card', `graph-card--${mode}`]} id="relationships">
  <div class="viz-head graph-heading"><div><h3>{title}</h3><p>选择节点或关系查看详情；拖动与滚轮可平移缩放。</p></div>{exploreHref && <a class="graph-link" href={exploreHref}>查看完整关系图 →</a>}</div>
  <div class="relation-legend" aria-label="关系图例"><span><i class="legend-line directed"></i>有向关系</span><span><i class="legend-line reflects"></i>反映</span><span><i class="legend-line symmetric"></i>相关 / 重叠</span></div>
  {mode === 'full' && <div class="graph-toolbar" aria-label="关系图控制">
    <label>查找节点 <input type="search" data-graph-search list={`${id}-nodes`} placeholder="输入名称或 stable ID" /></label>
    <datalist id={`${id}-nodes`}>{nodes.map(item => <option value={String(item.data.id)}>{String(item.data.label)}</option>)}</datalist>
    <button type="button" data-graph-action="zoom-in" aria-label="放大">＋</button><button type="button" data-graph-action="zoom-out" aria-label="缩小">－</button><button type="button" data-graph-action="fit">适应视图</button>
  </div>}
  <div class="graph" id={id} data-graph={JSON.stringify(graph)} data-graph-mode={mode} data-focus-id={focusId} data-concept-ids={JSON.stringify(conceptIds)} role="img" aria-label={title}></div>
  <div class="graph-status" data-graph-status aria-live="polite">悬停或选择一条关系，可查看准确的 relation type。</div>
</div>
<script>
  import cytoscape from 'cytoscape';
  document.querySelectorAll<HTMLElement>('[data-graph]').forEach((element) => {
    if (element.dataset.ready) return;
    element.dataset.ready = 'true';
    const card = element.closest<HTMLElement>('.graph-card');
    const status = card?.querySelector<HTMLElement>('[data-graph-status]');
    const graph = JSON.parse(element.dataset.graph || '[]');
    const mode = element.dataset.graphMode || 'local';
    const focusId = element.dataset.focusId;
    const conceptIds = new Set<string>(JSON.parse(element.dataset.conceptIds || '[]'));
    const layout = mode === 'full'
      ? { name: 'cose', animate: false, fit: true, padding: 46, nodeRepulsion: 11000, idealEdgeLength: 125, edgeElasticity: 90, gravity: .2, numIter: 1300 }
      : mode === 'local'
        ? { name: 'concentric', fit: true, padding: 42, minNodeSpacing: 42, concentric: (node: cytoscape.NodeSingular) => node.id() === focusId ? 2 : 1, levelWidth: () => 1 }
        : { name: 'breadthfirst', directed: true, fit: true, padding: 48, spacingFactor: 1.45, roots: '#central-bank' };
    const cy = cytoscape({container: element, elements: graph, minZoom: .25, maxZoom: 2.4, layout, style: [
      {selector:'node',style:{'background-color':'#e3eee8','border-color':'#0d6b50','border-width':1.5,label:'data(label)','font-size':11.5,'font-weight':600,color:'#15241f','text-wrap':'wrap','text-max-width':'106px','text-valign':'center','text-halign':'center',shape:'round-rectangle',width:118,height:44,padding:'4px'}},
      {selector:'node[kind="indicator"]',style:{'background-color':'#0d6b50','border-color':'#064b38',color:'#fff'}},
      {selector:'node.focus',style:{'background-color':'#fff3d8','border-color':'#d98e26','border-width':4,color:'#15241f','underlay-color':'#d98e26','underlay-opacity':.12,'underlay-padding':8}},
      {selector:'node.selected',style:{'border-color':'#d98e26','border-width':3}},
      {selector:'.dimmed',style:{opacity:.18}},
      {selector:'edge',style:{width:2,'line-color':'#92a49b','target-arrow-color':'#92a49b','target-arrow-shape':'triangle','arrow-scale':.8,'curve-style':'bezier'}},
      {selector:'edge[type="REFLECTS"]',style:{'line-style':'dashed','line-color':'#d98e26','target-arrow-color':'#d98e26'}},
      {selector:'edge[type="CORRELATES"], edge[type="OVERLAPS_WITH"]',style:{'line-style':'dotted','line-color':'#d98e26','target-arrow-shape':'none'}},
      {selector:'edge.selected',style:{width:4,'line-color':'#d98e26','target-arrow-color':'#d98e26',opacity:1}}
    ]});
    if (focusId) cy.getElementById(focusId).addClass('focus');
    const describeEdge = (edge: cytoscape.EdgeSingular) => { if (status) status.textContent = `${edge.source().data('label')} — ${edge.data('type')} → ${edge.target().data('label')}`; };
    const clearSelection = () => cy.elements().removeClass('selected dimmed');
    cy.on('mouseover tap', 'edge', event => describeEdge(event.target));
    cy.on('tap', 'edge', event => { clearSelection(); event.target.addClass('selected'); });
    cy.on('tap', 'node', event => {
      const node = event.target;
      if (conceptIds.has(node.id())) { window.location.href = `/concepts/${node.id()}`; return; }
      clearSelection(); cy.elements().not(node.closedNeighborhood()).addClass('dimmed'); node.closedNeighborhood().addClass('selected');
      if (status) status.textContent = `${node.data('label')} · stable ID: ${node.id()} · 图谱抽象节点，暂无独立概念页`;
    });
    cy.on('tap', event => { if (event.target === cy) clearSelection(); });
    const fit = () => { cy.resize(); cy.fit(cy.elements(), mode === 'full' ? 50 : 38); };
    cy.one('layoutstop', fit);
    new ResizeObserver(() => requestAnimationFrame(fit)).observe(element);
    card?.querySelector('[data-graph-action="zoom-in"]')?.addEventListener('click', () => cy.zoom({level:Math.min(cy.zoom()*1.2,cy.maxZoom()),renderedPosition:{x:element.clientWidth/2,y:element.clientHeight/2}}));
    card?.querySelector('[data-graph-action="zoom-out"]')?.addEventListener('click', () => cy.zoom({level:Math.max(cy.zoom()/1.2,cy.minZoom()),renderedPosition:{x:element.clientWidth/2,y:element.clientHeight/2}}));
    card?.querySelector('[data-graph-action="fit"]')?.addEventListener('click', () => { clearSelection(); fit(); });
    const searchInput = card?.querySelector<HTMLInputElement>('[data-graph-search]');
    searchInput?.addEventListener('input', () => {
      const query = searchInput.value.trim().toLocaleLowerCase();
      const node = cy.nodes().filter(item => item.id().toLocaleLowerCase() === query || String(item.data('label')).toLocaleLowerCase().includes(query)).first();
      if (!node.length) { if (status) status.textContent = `未找到节点：${searchInput.value}`; return; }
      clearSelection(); cy.elements().not(node.closedNeighborhood()).addClass('dimmed'); node.closedNeighborhood().addClass('selected');
      cy.animate({center:{eles:node},zoom:Math.max(cy.zoom(),1.15)},{duration:350}); if (status) status.textContent = `${node.data('label')} · stable ID: ${node.id()}`;
    });
  });
</script>
<style>
  .graph-heading p{margin:3px 0 0;color:var(--muted);font-size:12px}.graph-link{color:var(--green);font-size:13px;font-weight:800;white-space:nowrap}.relation-legend{margin-bottom:12px}.relation-legend span{display:inline-flex;align-items:center;gap:7px}.legend-line{display:inline-block;width:24px;border-top:2px solid #92a49b;position:relative}.legend-line.directed::after,.legend-line.reflects::after{content:"";position:absolute;right:-1px;top:-4px;border-left:6px solid #92a49b;border-top:3px solid transparent;border-bottom:3px solid transparent}.legend-line.reflects{border-color:#d98e26;border-top-style:dashed}.legend-line.reflects::after{border-left-color:#d98e26}.legend-line.symmetric{border-color:#d98e26;border-top-style:dotted}.graph-card--overview .graph{height:580px}.graph-card--local .graph{height:470px}.graph-card--full{margin:0}.graph-card--full .graph{height:74vh;min-height:620px}.graph-toolbar{display:flex;align-items:end;gap:8px;margin:8px 0 12px}.graph-toolbar label{margin-right:auto;color:var(--muted);font-size:12px}.graph-toolbar input{display:block;width:min(360px,50vw);margin-top:4px;border:1px solid var(--line);border-radius:9px;background:#fff;padding:9px 11px;font:inherit}.graph-toolbar button{border:1px solid var(--line);border-radius:9px;background:#fff;padding:9px 12px;color:var(--ink);cursor:pointer}.graph-toolbar button:hover,.graph-toolbar button:focus-visible{border-color:var(--green);color:var(--green)}.graph-status{min-height:28px;margin-top:10px;padding:7px 10px;border-radius:8px;background:#f1f3ed;color:var(--muted);font-size:12px}
  @media(max-width:760px){.graph-heading{align-items:flex-start;gap:10px}.graph-heading p{display:none}.graph-card--overview .graph{height:500px}.graph-card--local .graph{height:420px}.graph-card--full .graph{height:68vh;min-height:480px}.graph-toolbar{flex-wrap:wrap}.graph-toolbar label{width:100%;margin:0}.graph-toolbar input{width:100%}.relation-legend span{font-size:10px}}
</style>
