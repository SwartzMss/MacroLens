---
import { isExplainableRelation, macroNodeTypeLabels, type ConceptRelation, type ExplainableRelationType, type RelationType } from '../data/graphRegistry';
type ConceptLink = { data: { id: string; name: string } };
const { conceptId, conceptName, relations, concepts = [] } = Astro.props as { conceptId: string; conceptName: string; relations: ConceptRelation[]; concepts?: ConceptLink[] };
const conceptsById = new Map(concepts.map(concept => [concept.data.id, concept]));
const labels: Record<RelationType, string> = { CAUSES:'导致',AFFECTS:'影响',REFLECTS:'反映',CORRELATES:'通常相关',COMPONENT_OF:'构成',IMPLEMENTS:'实施',USES:'使用',OVERLAPS_WITH:'范围重叠',MEASURES:'衡量',DERIVED_FROM:'派生自' };
const explainableLabels: Record<ExplainableRelationType, string> = { leading_indicator:'领先指标',leading_factor:'领先因素',synchronous_indicator:'同步指标',lagging_indicator:'滞后指标',transmission:'传导环节' };
function groupFor(item: ConceptRelation) {
  if (item.direction === 'symmetric') return '与什么相互关联';
  const { type } = item.relation;
  if (item.direction === 'incoming') {
    if (type === 'AFFECTS' || type === 'CAUSES') return '它受什么影响';
    if (type === 'COMPONENT_OF') return '它由什么构成';
    if (type === 'DERIVED_FROM') return '什么由它派生';
    return '哪些关系指向它';
  }
  if (type === 'AFFECTS' || type === 'CAUSES') return '它影响什么';
  if (type === 'REFLECTS' || type === 'MEASURES') return '它反映 / 衡量什么';
  if (type === 'COMPONENT_OF') return '它构成什么';
  if (type === 'DERIVED_FROM') return '它派生自什么';
  return '它如何参与传导';
}
const grouped = new Map<string, ConceptRelation[]>();
for (const relation of relations) {
  const heading = groupFor(relation);
  grouped.set(heading, [...(grouped.get(heading) ?? []), relation]);
}
const groups = [...grouped];
---
{relations.length > 0 && <section class="relationship-block" aria-labelledby={`${conceptId}-relationships`}><div class="eyebrow">关系脉络</div><h2 id={`${conceptId}-relationships`}>它与其他概念如何关联</h2><div class="relationship-groups">{groups.map(([heading, items]) => <section class="relationship-group"><h3>{heading}</h3><div class="relationship-list">{items.map(item => {
  const linked = conceptsById.get(item.other.id);
  const currentIsSource = item.relation.source === conceptId;
  const otherNode = linked ? <a href={`/concepts/${linked.data.id}`}>{linked.data.name}</a> : <span class="relationship-abstract">{item.other.label}<small>图谱概念 · {macroNodeTypeLabels[item.other.type]}</small></span>;
  const metadata = isExplainableRelation(item.relation) ? item.relation : null;
  const cardClasses = ['relationship-card', item.direction === 'symmetric' && 'is-symmetric', metadata && 'is-explainable'];
  const summaryText = <span class="relationship-summary-text">
    <span class="relationship-current">{currentIsSource ? conceptName : item.other.label}</span>
    <span class="relationship-kind"><small>{metadata ? explainableLabels[metadata.relation] : labels[item.relation.type]}</small>{item.direction === 'symmetric' ? '↔' : '→'}</span>
    <span class="relationship-current">{currentIsSource ? item.other.label : conceptName}</span>
  </span>;
  const linkedSummary = <div class="relationship-summary">
    {currentIsSource ? <span class="relationship-current">{conceptName}</span> : otherNode}
    <span class="relationship-kind"><small>{labels[item.relation.type]}</small>{item.direction === 'symmetric' ? '↔' : '→'}</span>
    {currentIsSource ? otherNode : <span class="relationship-current">{conceptName}</span>}
  </div>;
  if (metadata) return <details open class:list={cardClasses} data-explainable-relation>
    <summary>{summaryText}</summary>
    <div class="relationship-detail">
      <div class="relationship-detail-endpoints">
        <div><small>来源</small>{currentIsSource ? <span class="relationship-current">{conceptName}</span> : otherNode}</div>
        <div><small>目标</small>{currentIsSource ? otherNode : <span class="relationship-current">{conceptName}</span>}</div>
      </div>
      <dl class="relationship-detail-grid">
        <div><dt>关系类型</dt><dd>{explainableLabels[metadata.relation]}</dd></div>
        <div><dt>时间关系</dt><dd>{metadata.lag}</dd></div>
        <div class="relationship-detail-explanation"><dt>解释</dt><dd>{metadata.explanation}</dd></div>
        <div class="relationship-detail-list"><dt>适用条件</dt><dd><ul>{metadata.applicability.map((item) => <li>{item}</li>)}</ul></dd></div>
        <div class="relationship-detail-list"><dt>局限与边界</dt><dd><ul>{metadata.limitations.map((item) => <li>{item}</li>)}</ul></dd></div>
      </dl>
      <div class="relationship-detail-evidence">
        <h4>证据 / 来源</h4>
        <ul>{metadata.evidence.map((item) => <li><a href={item.url} target="_blank" rel="noreferrer">{item.title}</a></li>)}</ul>
      </div>
    </div>
  </details>;
  return <div class:list={cardClasses}>{linkedSummary}</div>;
})}</div></section>)}</div></section>}
<style>
.relationship-block{margin:54px 0}.relationship-block>h2{margin-top:8px}.relationship-groups{display:grid;gap:18px}.relationship-group{border-top:1px solid var(--line);padding-top:16px}.relationship-group h3{margin:0 0 12px;font-size:15px;color:var(--muted)}.relationship-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.relationship-card{min-height:82px;border:1px solid var(--line);border-radius:13px;background:var(--card);font-size:14px}.relationship-summary,.relationship-summary-text{display:grid;grid-template-columns:minmax(0,1fr) 58px minmax(0,1fr);align-items:center;gap:10px;min-height:82px;padding:14px}.relationship-card summary{display:block;cursor:pointer;list-style:none}.relationship-card summary::-webkit-details-marker{display:none}.relationship-card summary:focus-visible{outline:3px solid #a9d8c3;outline-offset:3px}.relationship-current{font-weight:700}.relationship-kind{display:flex;flex-direction:column;align-items:center;color:var(--green);font-size:15px;text-align:center}.relationship-kind small{font-size:9px}.relationship-card.is-symmetric .relationship-kind{color:var(--amber)}.relationship-card a,.relationship-abstract{display:flex;align-items:center;justify-content:space-between;gap:8px;font-weight:700}.relationship-card a{color:var(--green)}.relationship-card a:hover{text-decoration:underline}.relationship-abstract{flex-direction:column;align-items:flex-start}.relationship-abstract small{color:var(--muted);font-size:10px;font-weight:400}.relationship-card.is-explainable{border-color:#a9b8ae}.relationship-detail{padding:0 14px 14px;border-top:1px solid var(--line);color:var(--muted);font-size:13px}.relationship-detail-endpoints{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:14px 0 8px}.relationship-detail-endpoints>div{display:flex;flex-direction:column;gap:4px;padding:10px;background:#f0eee5;border-radius:9px}.relationship-detail-endpoints small{font-size:11px}.relationship-detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:8px 0}.relationship-detail-grid div{padding:10px;background:#f0eee5;border-radius:9px}.relationship-detail-grid dt{font-size:11px}.relationship-detail-grid dd{margin:4px 0 0;color:var(--ink);font-weight:700}.relationship-detail-grid code{margin-left:4px;color:var(--muted);font-size:11px;font-weight:400}.relationship-detail-explanation{grid-column:1 / -1}.relationship-detail-explanation dd{line-height:1.6}.relationship-detail-list dd{font-weight:400}.relationship-detail-list ul,.relationship-detail-evidence ul{display:grid;gap:4px;margin:0;padding-left:18px}.relationship-detail-list li{line-height:1.5}.relationship-detail-evidence{margin-top:10px;padding:10px;background:#f0eee5;border-radius:9px}.relationship-detail-evidence h4{margin:0 0 6px;font-size:11px;font-weight:400}.relationship-detail-evidence a{display:inline;color:var(--green);font-weight:400;line-height:1.5}.relationship-detail-evidence a:hover{text-decoration:underline}.relationship-detail-note{display:block}.relationship-card.is-explainable:not([open]) .relationship-summary-text::after{content:'展开说明';grid-column:1 / -1;color:var(--muted);font-size:11px}.relationship-card.is-explainable[open] .relationship-summary-text::after{content:'收起说明';grid-column:1 / -1;color:var(--muted);font-size:11px}@media(max-width:760px){.relationship-list{grid-template-columns:1fr}.relationship-summary,.relationship-summary-text{padding:12px}.relationship-current,.relationship-card a,.relationship-abstract{overflow-wrap:anywhere}.relationship-detail-grid,.relationship-detail-endpoints{grid-template-columns:1fr}}
</style>
