---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/search.css';
---
<BaseLayout title="搜索｜MacroLens"><div class="shell search-wrap"><h1>搜索</h1><a class="search-back-link" href="/concepts/">← 返回知识库</a><div id="search"></div></div><link href="/pagefind/pagefind-ui.css" rel="stylesheet"><script is:inline src="/pagefind/pagefind-ui.js"></script><script is:inline>window.addEventListener('DOMContentLoaded',()=>{const query=new URLSearchParams(window.location.search).get('q')?.trim()??'';const ui=new PagefindUI({element:'#search',showSubResults:false,showImages:false,excerptLength:24,translations:{placeholder:'搜索 M2、通胀、利率…',zero_results:'没有找到相关概念'}});ui.triggerFilters({content:'concept'});if(query)ui.triggerSearch(query);});</script></BaseLayout>
