---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/search.css';
---
<BaseLayout title="搜索｜MacroLens"><div class="shell search-wrap"><div class="eyebrow">搜索 MacroLens</div><h1>搜索</h1><p>从概念、学习内容和当前宏观中找到你想了解的内容。</p><div id="search"></div></div><link href="/pagefind/pagefind-ui.css" rel="stylesheet"><script is:inline src="/pagefind/pagefind-ui.js"></script><script is:inline>window.addEventListener('DOMContentLoaded',()=>{const query=new URLSearchParams(window.location.search).get('q')?.trim()??'';const ui=new PagefindUI({element:'#search',showSubResults:true,translations:{placeholder:'例如：M2 为什么不等于通胀？',zero_results:'没有找到相关内容'}});if(query)ui.triggerSearch(query);});</script></BaseLayout>
