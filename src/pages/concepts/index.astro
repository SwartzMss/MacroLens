---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories, categoryIds, getCategory, type CategoryId } from '../../data/categories';
import { buildConceptCatalog } from '../../data/conceptCatalog';
import { topicRegistry } from '../../data/topics';
import '../../styles/concept-index.css';

const concepts = await getCollection('concepts');
const catalog = buildConceptCatalog(concepts, topicRegistry);

const grouped = new Map<CategoryId, typeof concepts>();
for (const concept of catalog.concepts) {
  const group = grouped.get(concept.data.category) ?? [];
  group.push(concept);
  grouped.set(concept.data.category, group);
}

const categoryGroups = [...grouped.entries()]
  .map(([id, items]) => ({ id, ...getCategory(id), items: items.sort((a, b) => a.data.order - b.data.order || a.data.id.localeCompare(b.data.id)) }))
  .sort((a, b) => a.order - b.order || a.id.localeCompare(b.id));
const categoryOptions = categoryIds.filter(id => grouped.has(id)).map(id => ({ id, ...categories[id] }));
const topicOptions = [...topicRegistry].sort((a, b) => a.order - b.order || a.id.localeCompare(b.id));
---
<BaseLayout title="概念索引｜MacroLens" description="按领域浏览 MacroLens 已收录的宏观经济概念。">
  <header class="index-head">
    <div class="shell index-head-layout">
      <div class="index-head-copy">
        <h1>概念查询</h1>
      </div>
      <form class="concept-search" action="/search/" method="get" role="search">
        <label class="sr-only" for="concept-search-query">搜索概念</label>
        <div class="concept-search-control"><input id="concept-search-query" name="q" type="search" placeholder="搜索概念，如 M1、M2、GDP" autocomplete="off" /><button type="submit">搜索</button></div>
      </form>
    </div>
  </header>
  <div class="shell concept-index">
    <details class="concept-filter-panel" data-filter-panel>
      <summary>筛选</summary>
      <form class="concept-filters" data-concept-filters>
        <div class="filter-field"><label for="concept-category">领域</label><select id="concept-category" name="category"><option value="all">全部领域</option>{categoryOptions.map(option => <option value={option.id}>{option.label}</option>)}</select></div>
        <div class="filter-field"><label for="concept-level">难度</label><select id="concept-level" name="level"><option value="all">全部难度</option><option value="basic">基础</option><option value="advanced">进阶</option></select></div>
        <div class="filter-field filter-topic"><label for="concept-topic">主题</label><select id="concept-topic" name="topic"><option value="all">全部主题</option>{topicOptions.map(option => <option value={option.id}>{option.label}</option>)}</select></div>
      </form>
    </details>
    <nav class="concept-quick-nav" aria-label="按领域快速浏览">
      <div class="concept-quick-links">{categoryOptions.map(option => <a href={`#${option.id}`}>{option.label}</a>)}</div>
    </nav>
    <div class="filter-empty" data-filter-empty hidden>
      <h2>暂无匹配的概念</h2>
      <p>试试调整领域、难度或主题，或清除筛选查看全部概念。</p>
      <button type="button" data-filter-reset>清除筛选</button>
    </div>
    {categoryGroups.map(group => <section class="category-section" id={group.id} data-category-section={group.id}>
      <header><h2>{group.label}</h2></header>
      <div class="index-grid">{group.items.map(concept => <a class="index-card" data-concept-card data-category={concept.data.category} data-topics={concept.data.topics.join(' ')} data-level={concept.data.level} href={`/concepts/${concept.data.id}`}>
        <h3>{concept.data.name}</h3><span aria-hidden="true">↗</span>
      </a>)}</div>
    </section>)}
  </div>
  <script>import '../../scripts/concept-filters';</script>
</BaseLayout>
