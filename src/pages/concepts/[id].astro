---
import { getCollection } from 'astro:content';
import ConceptReader from '../../components/ConceptReader.astro';
import { buildConceptCatalog } from '../../data/conceptCatalog';
import { topicRegistry } from '../../data/topics';
export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  buildConceptCatalog(concepts, topicRegistry);
  return concepts.map(entry => ({ params: { id: entry.data.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<ConceptReader entry={entry} />
