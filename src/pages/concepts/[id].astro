---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndicatorChart from '../../components/IndicatorChart.astro';
import ConceptGraph from '../../components/ConceptGraph.astro';
import { getIndicatorData } from '../../data/indicatorRegistry';
import { getGraphData } from '../../data/graphRegistry';
export async function getStaticPaths(){return (await getCollection('concepts')).map(entry=>({params:{id:entry.id},props:{entry}}));}
const { entry } = Astro.props; const { Content, headings } = await render(entry);
const indicator=entry.data.chart ? getIndicatorData(entry.data.chart) : null;
const graph=entry.data.graph ? getGraphData(entry.data.graph, entry.data.id) : null;
const categoryLabels: Record<string, string> = { money: '货币', inflation: '通胀', growth: '经济增长', fiscal: '财政', credit: '信用', exchange: '汇率' };
const categoryLabel = categoryLabels[entry.data.category] ?? entry.data.category;
---
<BaseLayout title={`${entry.data.name}：${entry.data.subtitle}｜MacroLens`} description={entry.data.subtitle}><header class="page-head"><div class="shell"><div class="breadcrumbs"><a href="/">首页</a> / {categoryLabel} / {entry.data.name}</div><h1 class="concept-title">{entry.data.name}</h1><p class="lead">{entry.data.subtitle}</p><div class="meta"><span>来源：{entry.data.source}</span>{entry.data.definition?.effectiveFrom && <span>定义生效：{entry.data.definition.effectiveFrom}</span>}{entry.data.definition?.asOf && <span>定义确认至：{entry.data.definition.asOf}</span>}<span>国家/地区：{entry.data.country}</span></div></div></header><div class="shell concept-layout"><article class="prose" data-pagefind-body><Content />{indicator && <IndicatorChart indicator={indicator} title={`${entry.data.name} 历史增速`} />}{graph && <ConceptGraph graph={graph} title={`${entry.data.name} 的关系网络`} />}</article><aside class="side-nav"><b>本页内容</b>{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</aside></div></BaseLayout>
