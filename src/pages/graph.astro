---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RelationshipExplorer from '../components/RelationshipExplorer.astro';
import { getExplainableRelationData } from '../data/graphRegistry';
import '../styles/explorer.css';

const concepts = await getCollection('concepts');
const { nodes } = getExplainableRelationData('macro');
---

<BaseLayout title="关系浏览器｜MacroLens" description="按节点浏览带有类型、时间和解释的宏观关系 metadata。">
  <div class="shell graph-page">
    <header class="graph-page-head">
      <div class="eyebrow">Relationship explorer</div>
      <h1>按节点浏览关系</h1>
      <p class="lead">选择一个指标或概念，阅读它受什么影响、影响什么，以及与什么通常相关；展开关系卡片查看关系类型、时间和解释。</p>
      <p class="graph-disclaimer">这是由 MacroLens 手工维护的解释性关系数据浏览器，不代表确定因果，不做实时预测或 quantitative causal inference，也不提供投资建议。</p>
    </header>
    <RelationshipExplorer nodes={nodes} concepts={concepts} initialNodeId="m2" />
  </div>
</BaseLayout>
