---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageFeedback from '../../../components/PageFeedback.astro';
import CourseRuntime from '../../../components/learning/CourseRuntime.astro';
import LearningSelfCheck from '../../../components/learning/LearningSelfCheck.astro';
import { courseOutline, courseLessonHref } from '../../../data/courseOutline';
import '../../../styles/course.css';
export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return courseOutline.filter(item => item.published).map(item => {
    const lesson = lessons.find(entry => entry.id === item.id);
    if (!lesson) throw new Error(`Missing published lesson: ${item.id}`);
    return { params: { lessonId: item.id }, props: { lesson } };
  });
}
const { lesson } = Astro.props;
const { Content, headings } = await render(lesson);
const index = courseOutline.findIndex(item => item.id === lesson.id);
const previous = courseOutline[index - 1];
const next = courseOutline[index + 1];
const nextReason = courseOutline[index]?.nextReason;
const sections = headings.filter(item => item.depth === 2);
const isFinalLesson = lesson.id === 'reading-news';
---
<BaseLayout title={`${lesson.data.title}｜学习经济｜MacroLens`} description={lesson.data.description}>
  <div class="course-shell" data-course-lesson={lesson.id} data-pagefind-body>
    <header>
      <a class="course-back-link" href="/learn/">返回入门主线</a>
      <p class="course-kicker">第 {index + 1} 章 · 约 {lesson.data.minutes} 分钟</p>
      <h1>{lesson.data.title}</h1>
      <p class="course-lead">{lesson.data.description}</p>
    </header>
    <details class="course-mobile-toc">
      <summary>这一章我们聊什么</summary>
      <nav aria-label="本章目录（手机）">
        {sections.map(item => <a href={`#${item.slug}`}>{item.text}</a>)}
      </nav>
    </details>
    <div class="course-layout">
      <article class="course-body">
        <section class="course-overview" aria-label="本章学习提示">
          {lesson.data.recall && <div>
            <h2 id={`${lesson.id}-recall`}>先把前面的问题接回来</h2>
            <p>{lesson.data.recall}</p>
          </div>}
          <div>
            <h2 id={`${lesson.id}-goals`}>这一章要弄明白什么</h2>
            <ul>
              {lesson.data.goals.map(goal => <li>{goal}</li>)}
            </ul>
          </div>
        </section>
        <section class="course-model" aria-labelledby={`${lesson.id}-model`}>
          <p class="course-model-label">先记住一个基本方向</p>
          <p id={`${lesson.id}-model`}>{lesson.data.model}</p>
          <p class="course-model-note">这是方便开始思考的方向，正文会再看哪些条件会让它变慢、变弱或走向不同。</p>
        </section>
        <Content />
        <section class="course-takeaways" aria-labelledby={`${lesson.id}-takeaways`}>
          <h2 id={`${lesson.id}-takeaways`}>学完后带走</h2>
          <ul>
            {lesson.data.takeaways.map(takeaway => <li>{takeaway}</li>)}
          </ul>
        </section>
        {isFinalLesson && <LearningSelfCheck />}
        <section class="course-actions" aria-label="阅读进度">
          <button class="course-start" type="button" data-course-complete hidden>我读完这一章了</button>
          <p class="course-note" data-course-status aria-live="polite">开启 JavaScript 后可以保存阅读进度。</p>
          {previous?.published && <a href={courseLessonHref(previous.id)}>← 上一章：{previous.title}</a>}
          {next && <div class="course-next">
            <strong>接下来：{next.title}</strong>
            <p>{nextReason}</p>
            {next.published
              ? <a href={courseLessonHref(next.id)}>继续下一章 →</a>
              : <p class="course-note">这一章正在编写，完成后会在入门主线开放。</p>}
          </div>}
          {!next && <div class="course-next">
            <strong>主线先收束在这里</strong>
            <p>{nextReason}</p>
          </div>}
          <a href="/learn/">返回主线，查看完整大纲 →</a>
        </section>
        <PageFeedback pageId={`learn:course-${lesson.id}`} mode="course" />
      </article>
      <nav class="course-toc" aria-label="本章目录">
        <strong>这一章我们聊什么</strong>
        {sections.map(item => <a href={`#${item.slug}`}>{item.text}</a>)}
      </nav>
    </div>
  </div>
  <CourseRuntime />
</BaseLayout>
