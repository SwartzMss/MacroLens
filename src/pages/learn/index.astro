---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseRuntime from '../../components/learning/CourseRuntime.astro';
import { courseOutline, courseLessonHref } from '../../data/courseOutline';
import { explorations, explorationHref } from '../../data/explorations';
import '../../styles/course.css';
const publishedCount = courseOutline.filter(chapter => chapter.published).length;
const publishedExplorations = explorations.filter(exploration => exploration.published);
---
<BaseLayout title="学习经济｜MacroLens" description="从日常生活出发，一步步理解经济怎样运转。无需经济学基础。">
  <div class="course-shell" data-pagefind-body>
    <header>
      <div class="course-kicker">学习经济 · 从生活里的问题开始</div>
      <h1>看懂经济，从身边的事开始</h1>
      <p class="course-lead">买一份早餐、领一次工资、决定要不要借钱。这些熟悉的事，怎样连成我们共同生活的经济？我们从头讲起，不需要你先学会一串名词。</p>
      <a class="course-start" data-course-resume href={courseLessonHref(courseOutline[0].id)}>开始第一章 →</a>
    </header>
    <section aria-labelledby="outline">
      <h2 id="outline">入门主线</h2>
      <p>按下面的顺序，把问题一个个想明白。目前已开放 {publishedCount} 章{publishedCount < courseOutline.length ? '，其余章节正在编写，不计入已开放课程的进度。' : '，可以按自己的节奏学习和回顾。'}</p>
      <ol class="course-outline">
        {courseOutline.map((chapter, index) => <li class={chapter.published ? 'is-published' : 'is-unpublished'}>
          <span class="course-number">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{chapter.published ? <a href={courseLessonHref(chapter.id)}>{chapter.title}</a> : chapter.title}</h3>
            <p>{chapter.summary}</p>
          </div>
        </li>)}
      </ol>
    </section>
    <section class="course-explore" aria-labelledby="explore">
      <h2 id="explore">问题探索</h2>
      <p>带着一个具体问题，把事情想得更明白。这里的文章可以独立阅读，不影响入门主线进度。</p>
      <div class="course-explore-list">
        {publishedExplorations.map(exploration => <article class="course-explore-card">
          <p class="course-kicker">问题探索 · 约 {exploration.minutes} 分钟</p>
          <h3><a href={explorationHref(exploration.id)}>{exploration.title}</a></h3>
          <p>{exploration.summary}</p>
          <a class="course-explore-link" href={explorationHref(exploration.id)}>开始阅读 →</a>
        </article>)}
      </div>
    </section>
  </div>
  <CourseRuntime />
</BaseLayout>
