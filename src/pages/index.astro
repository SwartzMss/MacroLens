---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConceptGraph from '../components/ConceptGraph.astro';
import { getCollection } from 'astro:content';
import { getGraphOverview } from '../data/graphRegistry';
const conceptIds = (await getCollection('concepts')).map(concept => concept.data.id);
const macroGraph = getGraphOverview('macro', [
  'central-bank', 'monetary-policy', 'policy-rate', 'rrr', 'omo',
  'financing-conditions', 'credit', 'm2', 'activity', 'macro',
  'economic-activity', 'gdp', 'pmi', 'business-activity-conditions'
]);
---
<BaseLayout><div class="shell"><section class="hero"><div><div class="eyebrow">Macroeconomics, made legible</div><h1>看懂钱，<br>如何流动。</h1><p class="lead">MacroLens 用清晰的概念、可追溯的关系和真实世界的数据，帮你建立宏观经济的直觉。</p></div><p class="hero-note">第一条学习路径从 M1 / M2 开始：它们是什么、为何变化，以及为什么“钱变多”不等于资产和物价必然上涨。</p></section>
<section class="section"><div class="section-head"><div><div class="eyebrow">Start here</div><h2>先认识两种“钱”</h2></div><p>约 10 分钟完成</p></div><div class="grid"><a class="concept-card" href="/concepts/m1"><div class="number">M1</div><h3>交易中的钱</h3><p>理解高流动性货币如何反映企业与居民的资金活跃程度。</p><div class="tags"><span class="tag">定义口径</span><span class="tag">情景解读</span><span class="tag">历史数据</span></div></a><a class="concept-card" href="/concepts/m2"><div class="number">M2</div><h3>更宽的货币总量</h3><p>理解存款、信贷与广义货币，以及“水多”为什么不必然上涨。</p><div class="tags"><span class="tag">信用派生</span><span class="tag">传导机制</span><span class="tag">常见误区</span></div></a></div></section>
<section class="section"><div class="section-head"><div><div class="eyebrow">Money → Credit</div><h2>继续走进融资链条</h2></div><p>从现金到借贷成本</p></div><div class="grid"><a class="concept-card" href="/concepts/m0"><div class="number">M0</div><h3>流通中的现金</h3><p>看懂最窄的一层货币，以及节日、支付方式与现金需求。</p></a><a class="concept-card" href="/concepts/credit"><div class="number">贷</div><h3>人民币贷款与信贷</h3><p>区分余额、增量、期限和部门，理解贷款如何创造存款。</p></a><a class="concept-card" href="/concepts/social-financing"><div class="number">社融</div><h3>社会融资规模</h3><p>从实体经济一侧观察贷款、债券和其他融资渠道。</p></a><a class="concept-card" href="/concepts/lpr"><div class="number">LPR</div><h3>贷款定价参考</h3><p>区分政策利率、LPR、实际贷款利率与信用需求。</p></a></div></section>
<section class="section"><div class="section-head"><div><div class="eyebrow">Transmission</div><h2>不要跳过中间环节</h2></div></div><div class="path"><div class="path-step"><b>01 政策工具</b>利率、准备金率、公开市场操作</div><div class="path-step"><b>02 金融体系</b>银行流动性、信贷与融资条件</div><div class="path-step"><b>03 部门行为</b>企业投资、居民消费与储蓄</div><div class="path-step"><b>04 宏观结果</b>产出、就业、价格与资产</div></div></section><section class="section"><ConceptGraph graph={macroGraph} title="宏观传导主干" mode="overview" conceptIds={conceptIds} exploreHref="/graph" /></section></div></BaseLayout>
