---
import BaseLayout from '../layouts/BaseLayout.astro';
import MacroSnapshot from '../components/MacroSnapshot.astro';
import { buildMacroSnapshot } from '../data/macroSnapshot';

const snapshot = buildMacroSnapshot();
---

<BaseLayout
  title="当前宏观｜MacroLens"
  description="查看当前宏观经济的主要变化、依据、可能联系和下一期观察。"
  canonicalPath="/now/"
>
  <div class="shell">
    <MacroSnapshot snapshot={snapshot} />
  </div>
</BaseLayout>
