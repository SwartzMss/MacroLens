---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MacroNowQuestionNav from '../../components/MacroNowQuestionNav.astro';
import MacroNowLaborMap from '../../components/MacroNowLaborMap.astro';
import { buildMacroSnapshot, getMacroSnapshotIndicators, type MacroIndicatorId, type SnapshotEvidence } from '../../data/macroSnapshot';
import { formatSignalChange, homeStateLabels, localizeExplanation } from '../../data/home';
import '../../styles/macro-now.css';

const indicators = getMacroSnapshotIndicators();
const snapshot = buildMacroSnapshot(indicators);
const labor = snapshot.domains.find((domain) => domain.id === 'labor');
if (!labor) throw new Error('Macro Now labor page requires the labor domain');

const frequencyLabels: Record<string, string> = { monthly: '月度', quarterly: '季度', event: '事件' };
const evidenceRows = labor.evidence.map((evidence) => {
  const indicatorId = evidence.id.split(':')[0] as MacroIndicatorId;
  return { evidence, sources: indicators[indicatorId].sources };
});
const evidence = evidenceRows[0].evidence;
const formatLatest = (item: SnapshotEvidence) => `${item.latest.toFixed(item.metric === 'rate' ? 2 : 1)}${item.unit === '%' ? '%' : ` ${item.unit}`}`;
const formatRecentChange = (item: SnapshotEvidence) => item.change === null ? '暂无可比数据' : formatSignalChange(item);
const readingText = evidence.change === null
  ? '暂无上期可比读数，先记录本期水平。'
  : `${evidence.changeLabel}，最近一次变化为 ${formatRecentChange(evidence)}；这只是城镇劳动力范围内的失业率变化。`;
const evidenceById = new Map(labor.evidence.map((item) => [item.id, item]));
---

<BaseLayout
  title="失业率下降了，就业真的变好了吗？｜Macro Now｜MacroLens"
  description="从全国城镇调查失业率的最新读数，理解失业率的分母、就业质量、居民收入和劳动市场证据边界。"
>
  <main class="macro-now-question shell">
    <a class="macro-now-back" href="/now/">← 回到当前状态</a>
    <MacroNowQuestionNav current="labor" />
    <header class="macro-now-question-head">
      <div class="eyebrow">Macro Now · 当前状态</div>
      <h1>失业率下降了，就业真的变好了吗？</h1>
      <p class="macro-now-lead">先读清失业率的分母和范围，再判断就业机会、收入和不同群体的感受有没有同步变化。</p>
      <p class="macro-now-meta">数据集更新时间范围：{snapshot.freshness.earliestUpdatedAt} 至 {snapshot.freshness.latestUpdatedAt}</p>
    </header>

    <section class="macro-now-question-summary" aria-labelledby="macro-now-labor-current-title">
      <div>
        <div class="eyebrow">现在看到什么</div>
        <h2 id="macro-now-labor-current-title">{homeStateLabels[labor.state]}</h2>
      </div>
      <p>{localizeExplanation(labor.explanation)}</p>
    </section>

    <section class="macro-now-section" aria-labelledby="macro-now-labor-evidence-title">
      <div class="macro-now-section-head">
        <div>
          <div class="eyebrow">数据依据</div>
          <h2 id="macro-now-labor-evidence-title">先看这一个比率覆盖谁</h2>
        </div>
        <p>全国城镇调查失业率的分母是城镇劳动力，不是全部劳动年龄人口，也不是登记失业率。</p>
      </div>
      <div class="macro-now-evidence-grid">
        {evidenceRows.map(({ evidence: item, sources }) => <article class="macro-now-evidence-card">
          <header>
            <div>
              <a class="macro-now-evidence-name" href={item.conceptHref}>{item.name} →</a>
              <p>{item.valueLabel}</p>
            </div>
            <strong>{formatLatest(item)}</strong>
          </header>
          <p class="macro-now-evidence-reading">{readingText}</p>
          <dl>
            <div><dt>观测期</dt><dd>{item.observationPeriod}</dd></div>
            <div><dt>频率</dt><dd>{frequencyLabels[item.frequency] ?? item.frequency}</dd></div>
            <div><dt>更新</dt><dd>{item.updatedAt}</dd></div>
          </dl>
          <details class="macro-now-source-details">
            <summary>查看数据来源</summary>
            <ul>
              {sources.map((source) => <li>
                <a href={source.url} target="_blank" rel="noreferrer">{source.title} ↗</a>
                <small>{source.role === 'methodology' ? '口径说明' : '数据来源'} · {source.coverage} · {source.sourceDate}</small>
              </li>)}
            </ul>
          </details>
        </article>)}
      </div>
    </section>

    <MacroNowLaborMap row={evidence} />

    <section class="macro-now-section" aria-labelledby="macro-now-labor-reading-title">
      <div class="macro-now-section-head">
        <div>
          <div class="eyebrow">怎么读</div>
          <h2 id="macro-now-labor-reading-title">失业率只是劳动市场的一扇窗</h2>
        </div>
      </div>
      <div class="macro-now-reading-grid">
        <article>
          <h3>它是一个比率，不是人数</h3>
          <p>失业率看的是失业人口占城镇劳动力的比例。分子和分母都可能变化，不能看到比率下降就直接说就业人数增加。</p>
        </article>
        <article>
          <h3>有工作不等于工作感受相同</h3>
          <p>行业、地区、工时、工资和合同稳定性会影响个人感受。全国平均读数不能代替不同群体的劳动市场情况。</p>
        </article>
        <article>
          <h3>收入和消费还要再看</h3>
          <p>劳动市场变化可能通过就业机会和劳动收入影响居民收入，但传导需要时间，也会受到工资结构、转移支付和预期影响。</p>
        </article>
      </div>
    </section>

    <section class="macro-now-section" aria-labelledby="macro-now-labor-gaps-title">
      <div class="macro-now-section-head">
        <div>
          <div class="eyebrow">证据边界</div>
          <h2 id="macro-now-labor-gaps-title">还缺什么证据？</h2>
        </div>
        <p>当前读数能说明城镇劳动力范围内的失业率变化，还不能完整说明就业数量、质量和收入。</p>
      </div>
      <div class="macro-now-gap-list">
        <article>
          <h3>是就业增加，还是有人退出？</h3>
          <p>需要就业人数、劳动参与率和劳动力规模一起看，才能判断失业率变化来自哪一部分。</p>
          <div class="macro-now-links"><a href="/concepts/employment/">就业 →</a><a href="/concepts/labor-force-participation/">劳动参与率 →</a></div>
        </article>
        <article>
          <h3>不同群体是否一样？</h3>
          <p>青年、不同地区和行业的劳动市场可能与全国平均不同。群体数据要先确认年龄、在校生和统计范围。</p>
          <div class="macro-now-links"><a href="/concepts/youth-unemployment/">青年失业率 →</a><a href="/concepts/industrial-production/">工业生产 →</a></div>
        </article>
        <article>
          <h3>收入有没有跟上？</h3>
          <p>就业数量改善不保证每个家庭收入同步增加，还要结合工资、可支配收入和消费预期。</p>
          <div class="macro-now-links"><a href="/concepts/wages/">工资与劳动报酬 →</a><a href="/concepts/disposable-income/">可支配收入 →</a><a href="/concepts/income-expectations/">收入预期 →</a></div>
        </article>
      </div>
    </section>

    <section class="macro-now-next" aria-labelledby="macro-now-labor-next-title">
      <div>
        <div class="eyebrow">下一期看什么</div>
        <h2 id="macro-now-labor-next-title">继续核对劳动市场的范围和变化</h2>
      </div>
      {labor.watchNext.length > 0 ? <ul>{labor.watchNext.map((conclusion) => <li>
        <strong>{localizeExplanation(conclusion.title)}</strong>
        <p>{localizeExplanation(conclusion.explanation)}</p>
        <div class="macro-now-links">{conclusion.evidenceIds.map((id) => { const item = evidenceById.get(id); return item ? <a href={item.conceptHref}>{item.name} →</a> : null; })}</div>
      </li>)}</ul> : <p>目前没有单独触发的下一期观察项，继续按上面的读法核对新的劳动市场数据。</p>}
    </section>
  </main>
</BaseLayout>
