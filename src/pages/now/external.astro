---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MacroNowComparisonNote from '../../components/MacroNowComparisonNote.astro';
import MacroNowQuestionNav from '../../components/MacroNowQuestionNav.astro';
import MacroNowExternalMap from '../../components/MacroNowExternalMap.astro';
import MacroNowTrend from '../../components/MacroNowTrend.astro';
import { buildMacroSnapshot, getMacroSnapshotIndicators, type MacroIndicatorId, type SnapshotEvidence } from '../../data/macroSnapshot';
import { formatSignalChange, homeStateLabels, localizeExplanation } from '../../data/home';
import '../../styles/macro-now.css';

const indicators = getMacroSnapshotIndicators();
const snapshot = buildMacroSnapshot(indicators);
const external = snapshot.domains.find((domain) => domain.id === 'external');
if (!external) throw new Error('Macro Now external page requires the external domain');

const frequencyLabels: Record<string, string> = { monthly: '月度', quarterly: '季度', event: '事件' };
const evidenceRows = external.evidence.map((evidence) => {
  const indicatorId = evidence.id.split(':')[0] as MacroIndicatorId;
  return { evidence, indicator: indicators[indicatorId], sources: indicators[indicatorId].sources };
});
const formatLatest = (evidence: SnapshotEvidence) => {
  const unit = evidence.unit === 'index' ? '点' : evidence.unit;
  return `${evidence.latest.toFixed(evidence.metric === 'rate' ? 2 : 1)}${unit === '%' ? '%' : ` ${unit}`}`;
};
const formatRecentChange = (evidence: SnapshotEvidence) => evidence.change === null ? '暂无可比数据' : formatSignalChange(evidence);
const readingText = (evidence: SnapshotEvidence) => evidence.change === null
  ? '暂无上期可比读数，先记录本期水平。'
  : `${evidence.changeLabel}，最近一次变化为 ${formatRecentChange(evidence)}；这是人民币计价的货物金额同比，不是数量或价格指数。`;
const evidenceById = new Map(external.evidence.map((evidence) => [evidence.id, evidence]));
---

<BaseLayout
  title="出口在增长，外贸真的更强了吗？｜Macro Now｜MacroLens"
  description="从出口和进口的最新海关货物贸易金额同比，理解金额、数量、价格、国内需求和外部需求之间的证据边界。"
>
  <main class="macro-now-question shell">
    <a class="macro-now-back" href="/now/">← 回到当前宏观</a>
    <MacroNowQuestionNav current="external" />
    <header class="macro-now-question-head">
      <div class="eyebrow">Macro Now · 当前宏观</div>
      <h1>出口在增长，外贸真的更强了吗？</h1>
      <p class="macro-now-lead">先确认出口和进口分别测什么，再分开看金额变化、数量变化、价格变化和真实需求。</p>
      <p class="macro-now-meta">数据集更新时间范围：{snapshot.freshness.earliestUpdatedAt} 至 {snapshot.freshness.latestUpdatedAt}</p>
    </header>

    <section class="macro-now-question-summary" aria-labelledby="macro-now-external-current-title">
      <div>
        <div class="eyebrow">现在看到什么</div>
        <h2 id="macro-now-external-current-title">{homeStateLabels[external.state]}</h2>
      </div>
      <p>{localizeExplanation(external.explanation)}</p>
    </section>

    <section class="macro-now-section" aria-labelledby="macro-now-external-evidence-title">
      <div class="macro-now-section-head">
        <div>
          <div class="eyebrow">数据依据</div>
          <h2 id="macro-now-external-evidence-title">先确认这两条线到底测什么</h2>
        </div>
        <p>两条数据都是海关总署按人民币计价的全国货物贸易金额月度同比，不是数量、价格、服务贸易或国际收支数据。</p>
      </div>
      <div class="macro-now-evidence-grid">
        {evidenceRows.map(({ evidence, indicator, sources }) => <article id={`macro-now-evidence-${evidence.id}`} class="macro-now-evidence-card">
          <header>
            <div>
              <a class="macro-now-evidence-name" href={evidence.conceptHref}>{evidence.name} →</a>
              <p>{evidence.valueLabel}</p>
            </div>
            <strong>{formatLatest(evidence)}</strong>
          </header>
          <p class="macro-now-evidence-reading">{readingText(evidence)}</p>
          <MacroNowComparisonNote method={evidence.comparisonMethod} />
          <MacroNowTrend indicator={indicator} seriesId={evidence.seriesId} />
          <dl>
            <div><dt>观测期</dt><dd>{evidence.observationPeriod}</dd></div>
            <div><dt>频率</dt><dd>{frequencyLabels[evidence.frequency] ?? evidence.frequency}</dd></div>
            <div><dt>更新</dt><dd>{evidence.updatedAt}</dd></div>
          </dl>
          <details class="macro-now-source-details">
            <summary>查看数据来源</summary>
            <ul>
              {sources.map((source) => <li>
                <a href={source.url} target="_blank" rel="noreferrer">{source.title} ↗</a>
                <small>{source.role === 'methodology' ? '口径说明' : '数据来源'} · {source.coverage} · {source.sourceDate}</small>
              </li>)}
            </ul>
          </details>
        </article>)}
      </div>
    </section>

    <MacroNowExternalMap rows={evidenceRows.map(({ evidence }) => evidence)} />

    <section class="macro-now-section" aria-labelledby="macro-now-external-reading-title">
      <div class="macro-now-section-head">
        <div>
          <div class="eyebrow">怎么读</div>
          <h2 id="macro-now-external-reading-title">金额增长，不能直接翻译成需求变强</h2>
        </div>
      </div>
      <div class="macro-now-reading-grid">
        <article>
          <h3>金额不是数量</h3>
          <p>出口金额同时受出口数量和价格影响。人民币计价的金额同比上升，不能单独说明卖出去的件数也按同样幅度增加。</p>
        </article>
        <article>
          <h3>出口和进口回答不同问题</h3>
          <p>出口更接近境外购买的货物金额，进口既可能反映国内购买，也可能反映企业生产所需的投入。两条线分化时，要分别解释。</p>
        </article>
        <article>
          <h3>海关货物贸易不是国际收支</h3>
          <p>海关统计主要回答货物进出境的金额，国际收支还包含服务、收入和金融交易。不能把一条贸易线当成整个外部部门。</p>
        </article>
      </div>
    </section>

    <section class="macro-now-section" aria-labelledby="macro-now-external-gaps-title">
      <div class="macro-now-section-head">
        <div>
          <div class="eyebrow">证据边界</div>
          <h2 id="macro-now-external-gaps-title">还缺什么证据？</h2>
        </div>
        <p>当前数据能说明货物金额的变化，还不能单独说明外部需求、竞争力或对外收支的完整状态。</p>
      </div>
      <div class="macro-now-gap-list">
        <article>
          <h3>数量和价格是谁在拉动？</h3>
          <p>需要贸易数量、出口价格和进口价格拆分，才能继续判断金额变化来自卖得更多还是价格变化。</p>
          <div class="macro-now-links"><a href="/concepts/trade-volume-and-price/">贸易数量与价格拆分 →</a><a href="/concepts/terms-of-trade/">贸易条件 →</a></div>
        </article>
        <article>
          <h3>外部需求到底怎样？</h3>
          <p>出口金额不能代表所有市场的订单和需求。还要看主要贸易伙伴、产品结构、订单和服务贸易。</p>
          <div class="macro-now-links"><a href="/concepts/exports/">出口 →</a><a href="/concepts/current-account/">经常账户 →</a></div>
        </article>
        <article>
          <h3>汇率和竞争力有没有变化？</h3>
          <p>汇率可能影响报价和成本，但双边汇率不等于一国对所有贸易伙伴的竞争力，还要确认报价方向和观察口径。</p>
          <div class="macro-now-links"><a href="/concepts/exchange-rate/">汇率 →</a><a href="/concepts/effective-exchange-rate/">有效汇率 →</a></div>
        </article>
      </div>
    </section>

    <section class="macro-now-next" aria-labelledby="macro-now-external-next-title">
      <div>
        <div class="eyebrow">下一期看什么</div>
        <h2 id="macro-now-external-next-title">继续核对出口和进口是否同向</h2>
      </div>
      {external.watchNext.length > 0 ? <ul>{external.watchNext.map((conclusion) => <li>
        <strong>{localizeExplanation(conclusion.title)}</strong>
        <p>{localizeExplanation(conclusion.explanation)}</p>
        <div class="macro-now-links">{conclusion.evidenceIds.map((id) => { const evidence = evidenceById.get(id); return evidence ? <a href={`#macro-now-evidence-${id}`}>{evidence.name} →</a> : null; })}</div>
      </li>)}</ul> : <p>目前没有单独触发的下一期观察项，继续按上面的读法核对新的出口和进口数据。</p>}
    </section>
  </main>
</BaseLayout>
