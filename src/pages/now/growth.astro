---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MacroNowComparisonNote from '../../components/MacroNowComparisonNote.astro';
import MacroNowQuestionNav from '../../components/MacroNowQuestionNav.astro';
import MacroNowRelationshipMap from '../../components/MacroNowRelationshipMap.astro';
import MacroNowTrend from '../../components/MacroNowTrend.astro';
import { buildMacroSnapshot, getMacroSnapshotIndicators, type MacroIndicatorId, type SnapshotEvidence } from '../../data/macroSnapshot';
import { formatSignalChange, homeStateLabels, localizeExplanation, getPmiReading } from '../../data/home';
import '../../styles/macro-now.css';

const indicators = getMacroSnapshotIndicators();
const snapshot = buildMacroSnapshot(indicators);
const growth = snapshot.domains.find((domain) => domain.id === 'growth');
if (!growth) throw new Error('Macro Now growth page requires the growth domain');

const frequencyLabels: Record<string, string> = {
  monthly: '月度',
  quarterly: '季度',
  event: '事件',
};
const evidenceRows = growth.evidence.map((evidence) => {
  const indicatorId = evidence.id.split(':')[0] as MacroIndicatorId;
  return { evidence, indicator: indicators[indicatorId], sources: indicators[indicatorId].sources };
});
const evidenceById = new Map(growth.evidence.map((evidence) => [evidence.id, evidence]));
const formatLatest = (evidence: SnapshotEvidence) => `${evidence.latest.toFixed(evidence.metric === 'rate' ? 2 : 1)}${evidence.unit === '%' ? '%' : ` ${evidence.unit}`}`;
const formatRecentChange = (evidence: SnapshotEvidence) => evidence.change === null ? '暂无可比数据' : formatSignalChange(evidence);
const readingText = (evidence: SnapshotEvidence) => evidence.id === 'pmi'
  ? getPmiReading(evidence)
  : `${evidence.changeLabel}${evidence.change === null ? '暂无可比数据' : ` ${formatRecentChange(evidence)}`}。`;
---

<BaseLayout
  title="经济活动在变快还是变慢？｜Macro Now｜MacroLens"
  description="从生产、消费、投资和 PMI 的最新数据，理解当前经济活动的变化、比较方法和证据边界。"
>
  <main class="macro-now-question shell">
    <a class="macro-now-back" href="/now/">← 回到当前状态</a>
    <MacroNowQuestionNav current="growth" />
    <header class="macro-now-question-head">
      <div class="eyebrow">Macro Now · 当前状态</div>
      <h1>经济活动在变快还是变慢？</h1>
      <p class="macro-now-lead">先看生产、消费、投资和调查指数各自的变化，再判断它们是否指向同一个方向。</p>
      <p class="macro-now-meta">数据集更新时间范围：{snapshot.freshness.earliestUpdatedAt} 至 {snapshot.freshness.latestUpdatedAt}</p>
    </header>

    <section class="macro-now-question-summary" aria-labelledby="macro-now-current-title">
      <div>
        <div class="eyebrow">现在看到什么</div>
        <h2 id="macro-now-current-title">{homeStateLabels[growth.state]}</h2>
      </div>
      <p>{localizeExplanation(growth.explanation)}</p>
    </section>

    <section class="macro-now-section" aria-labelledby="macro-now-evidence-title">
      <div class="macro-now-section-head">
        <div>
          <div class="eyebrow">数据依据</div>
          <h2 id="macro-now-evidence-title">把每个数字放回自己的位置</h2>
        </div>
        <p>读数的对象、时间和比较方法不同，不能直接拼成一个结论。</p>
      </div>
      <div class="macro-now-evidence-grid">
        {evidenceRows.map(({ evidence, indicator, sources }) => <article class="macro-now-evidence-card">
          <header>
            <div>
              <a class="macro-now-evidence-name" href={evidence.conceptHref}>{evidence.name} →</a>
              <p>{evidence.valueLabel}</p>
            </div>
            <strong>{formatLatest(evidence)}</strong>
          </header>
          <p class="macro-now-evidence-reading">{readingText(evidence)}</p>
          <MacroNowComparisonNote method={evidence.comparisonMethod} />
          <MacroNowTrend indicator={indicator} seriesId={evidence.seriesId} />
          <dl>
            <div><dt>观测期</dt><dd>{evidence.observationPeriod}</dd></div>
            <div><dt>频率</dt><dd>{frequencyLabels[evidence.frequency] ?? evidence.frequency}</dd></div>
            <div><dt>更新</dt><dd>{evidence.updatedAt}</dd></div>
          </dl>
          <details class="macro-now-source-details">
            <summary>查看数据来源</summary>
            <ul>
              {sources.map((source) => <li>
                <a href={source.url} target="_blank" rel="noreferrer">{source.title} ↗</a>
                <small>{source.role === 'methodology' ? '口径说明' : '数据来源'} · {source.coverage} · {source.sourceDate}</small>
              </li>)}
            </ul>
          </details>
        </article>)}
      </div>
    </section>

    <MacroNowRelationshipMap rows={evidenceRows} />

    <section class="macro-now-section" aria-labelledby="macro-now-reading-title">
      <div class="macro-now-section-head">
        <div>
          <div class="eyebrow">怎么读</div>
          <h2 id="macro-now-reading-title">先分开看，再放在一起</h2>
        </div>
      </div>
      <div class="macro-now-reading-grid">
        <article>
          <h3>PMI 是调查指数</h3>
          <p>PMI 反映调查对象对当月情况的回答，50 是常用的分界线。它和生产、销售的实际增速不是同一种读数。</p>
        </article>
        <article>
          <h3>总量和增速要分开</h3>
          <p>GDP、工业生产、零售和投资的统计范围、时间频率和比较方法不同。一个指标增速回落，不代表总量立刻减少。</p>
        </article>
        <article>
          <h3>同时变化还不等于互相造成</h3>
          <p>这些指标可以放在一条可能的经济链里观察，但还要补行业、收入、就业和时间差，才能继续解释变化从哪里来。</p>
        </article>
      </div>
    </section>

    <section class="macro-now-section" aria-labelledby="macro-now-gaps-title">
      <div class="macro-now-section-head">
        <div>
          <div class="eyebrow">证据边界</div>
          <h2 id="macro-now-gaps-title">还缺什么证据？</h2>
        </div>
        <p>当前数据能说明变化到哪一步，不能替我们补齐没有发布的部分。</p>
      </div>
      <div class="macro-now-gap-list">
        <article>
          <h3>家庭有没有真的感到改善？</h3>
          <p>生产和销售的总量不能代表每个家庭的收入、工作时间和购买力。还要结合就业、工资和可支配收入。</p>
          <div class="macro-now-links"><a href="/concepts/employment/">就业 →</a><a href="/concepts/wages/">工资 →</a><a href="/concepts/disposable-income/">可支配收入 →</a></div>
        </article>
        <article>
          <h3>变化是不是集中在少数行业？</h3>
          <p>总量变化可能由少数行业拉动。要判断是否更广泛，还需要行业分项、订单、库存和产能等资料。</p>
          <div class="macro-now-links"><a href="/concepts/industrial-production/">工业生产 →</a><a href="/concepts/inventory-cycle/">库存周期 →</a></div>
        </article>
        <article>
          <h3>这些变化能不能连成一条时间线？</h3>
          <p>季度、月度和调查数据的发布日期与观测期不一样。下一期发布后，要重新核对先后顺序和是否出现修订。</p>
          <div class="macro-now-links"><a href="/concepts/leading-indicators/">领先指标 →</a><a href="/concepts/gdp/">GDP →</a></div>
        </article>
      </div>
    </section>

    <section class="macro-now-next" aria-labelledby="macro-now-next-title">
      <div>
        <div class="eyebrow">下一期看什么</div>
        <h2 id="macro-now-next-title">继续核对同一组证据</h2>
      </div>
      {growth.watchNext.length > 0 ? <ul>{growth.watchNext.map((conclusion) => <li>
        <strong>{localizeExplanation(conclusion.title)}</strong>
        <p>{localizeExplanation(conclusion.explanation)}</p>
        <div class="macro-now-links">{conclusion.evidenceIds.map((id) => { const evidence = evidenceById.get(id); return evidence ? <a href={evidence.conceptHref}>{evidence.name} →</a> : null; })}</div>
      </li>)}</ul> : <p>目前没有单独触发的下一期观察项，继续按上面的读法核对新数据。</p>}
    </section>
  </main>
</BaseLayout>
